(ns example.demo.teacup.core
  "Teacup app shell: material-app, root model, bottom nav.

   Root state:
     :event   -- (cI nil) -- set to :start or :stop by buttons
     :formx   -- (cF ...) -- MX model owning the run (the UMI):
                             :samples :start-ms :secs-left :running?
                             :gyro :clock :sub
     :current-page-id -- (cI :chart)"
  (:require
    ["dart:async" :as async]
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    ["package:sensors_plus/sensors_plus.dart" :as sp]
    ["package:flutter_beep/flutter_beep.dart" :as beep]
    [tilton.mx.cell.base :as cb]
    [tilton.fmx.api :refer [dart-cb] :as fx]
    [tilton.mx.api :as mx
     :refer [dp cF cF+ cI mget mset! fmu make now-ms wmx-iso _cache-bound]]
    [example.demo.teacup.util :as u]
    [example.demo.teacup.sensor :as sensor]
    [example.demo.teacup.monitor :refer [monitor-page]]
    [example.demo.teacup.summary :refer [summary-page]]))

(def build-tag (.nextInt (math/Random) 1000))

(defn title-text []
  (str "Tai Chi Teacup v" build-tag))

(defn make-formx []
  (.playSysSound beep/FlutterBeep u/Begin-Recording)
  (let [gyro-atom (atom nil)]
    (make
      :name      :formx
      :samples   (cI [])
      :start-ms  (cI (now-ms))
      :secs-left (cI sensor/run-duration-s)
      :running?  (cI true :watch (fn [_ _ new prior _]
                                   (when (and (false? new) (true? prior))
                                     (.playSysSound beep/FlutterBeep u/End-Recording))))

      :gyro      (cF+ [:on-quiesce (fn [c]
                                     (when-let [^async/StreamSubscription sub (cb/c-value c)]
                                       (dp :gyro-cancelled!)
                                       (.cancel sub)))]
                   (dp :gyro-subscribing!)
                   (.listen (sp/gyroscopeEventStream
                              .samplingPeriod
                              (Duration .milliseconds sensor/sample-period-ms))
                     (fn [^sp/GyroscopeEvent ev]
                       (reset! gyro-atom ev))))

      :clock     (cF+ [:on-quiesce (fn [c]
                                     (when-let [^async/Timer tmr (cb/c-value c)]
                                       (dp :clock-cancelled!)
                                       (.cancel tmr)))]
                   (dp :clock-starting!)
                   (async/Timer.periodic (Duration .seconds 1)
                     (fn [^async/Timer tmr]
                       (wmx-iso
                         (when (mget me :running?)
                           (let [remaining (dec (mget me :secs-left))]
                             (dp :clock-tick! :secs-left remaining)
                             (mset! me :secs-left remaining)
                             (when (<= remaining 0)
                               (dp :clock-stopping!)
                               (.cancel tmr)
                               (mset! me :running? false))))))))

      :sub       (cF+ [:on-quiesce (fn [c]
                                     (when-let [^async/StreamSubscription sub (cb/c-value c)]
                                       (dp :sub-cancelled!)
                                       (.cancel sub)))]
                   (let [last-stamp (atom 0)
                         stream     (sp/userAccelerometerEventStream
                                      .samplingPeriod
                                      (Duration .milliseconds sensor/sample-period-ms))]
                     (dp :sensor-subscribing!)
                     (.listen stream
                       (sensor/make-listener me last-stamp gyro-atom)))))))

(defn make-app []
  (.playSysSound beep/FlutterBeep u/Sent-Message)
  (fx/material-app
    {:title (title-text)
     :theme (m/ThemeData .primarySwatch m/Colors.teal)}
    {:name            :teacup
     :event           (cI nil)
     :formx           (cF (case (mget me :event)
                             :start (make-formx)
                             :stop  nil
                             (_cache-bound)))
     :current-page-id (cI :chart)}
    (fx/scaffold
      {:appBar              (fx/app-bar
                              {:title (m/Text (title-text))})
       :bottomNavigationBar (cF
                              (let [root (fmu :teacup)]
                                (fx/bottom-navigation-bar
                                  {:currentIndex (if (= :chart (mget root :current-page-id)) 0 1)
                                   :onTap        (dart-cb [i]
                                                   (mset! root :current-page-id
                                                     (if (= i 0) :chart :summary)))}
                                  (fx/bottom-navigation-bar-item
                                    {:icon  (m/Icon m/Icons.show_chart)
                                     :label "Chart"}
                                    {})
                                  (fx/bottom-navigation-bar-item
                                    {:icon  (m/Icon m/Icons.grid_on)
                                     :label "Summary"}
                                    {}))))}
      (if (= :chart (mget (fmu :teacup) :current-page-id))
        (monitor-page)
        (summary-page)))))
