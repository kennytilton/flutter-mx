(ns example.demo.teacup.core
  "Tai Chi Teacup hello world.

   Captures 10 seconds of userAccelerometer data at 10 Hz (gravity
   removed) and plots:
     - xy-magnitude on the left axis [0, 5] m/s^2
     - z on the right axis [-5, +5] m/s^2 (mapped onto the same chart Y)

   Architecture:
     - :teacup root carries :running?, :samples, :start-ms, :secs-left.
     - :secs-left counts down from run-duration-s each second via the
       :clock Timer.periodic in the capture widget.
     - counter-label shows the countdown while running.
     - SafeArea keeps content clear of the Dynamic Island."
  (:require
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc
     :refer [LineChart]]
    [tilton.fmx.api :refer [dart-cb] :as fx]
    [tilton.mx.api :as mx
     :refer [dp cF cI mget mset! mswap! fmu now-ms]]
    [example.demo.teacup.sensor :as sensor :refer [capture]]
    [example.demo.teacup.plot   :as plot   :refer [line-chart chart-data]]))

(def build-tag (.nextInt (math/Random) 1000))

(defn title-text []
  (str "Tai Chi Teacup v" build-tag))

(defn counter-label [samples running? secs-left]
  (let [n (count samples)]
    (cond
      running?    (str n " samples  |  " secs-left "s remaining")
      (zero? n)   "Press Start"
      :else       (str "Captured " n " samples"))))

(defn- start! [root]
  (dp :start!)
  (mset! root :samples [])
  (mset! root :start-ms (now-ms))
  (mset! root :secs-left sensor/run-duration-s)
  (mset! root :running? true))

(defn- stop! [root]
  (dp :stop!)
  (mset! root :running? false))

(defn make-app []
  (fx/material-app
    {:title (title-text)
     :theme (m/ThemeData .primarySwatch m/Colors.teal)}
    {:name      :teacup
     :running?  (cI false)
     :start-ms  (cI nil)
     :secs-left (cI sensor/run-duration-s)
     :samples   (cI [])}
    (fx/scaffold
      {:appBar (fx/app-bar
                 {:title (m/Text (title-text))})}
      (fx/safe-area
        (fx/column
          {:mainAxisAlignment  m/MainAxisAlignment.spaceEvenly
           :crossAxisAlignment m/CrossAxisAlignment.stretch}

          ;; Status: sample count and countdown while running.
          (fx/text
            {:style     (p/TextStyle .fontSize 18.0 .color m/Colors.black)
             :textAlign m/TextAlign.center}
            (let [root (fmu :teacup)]
              (counter-label
                (mget root :samples)
                (mget root :running?)
                (mget root :secs-left))))

          ;; Start/Stop button.
          (fx/elevated-button
            {:onPressed (dart-cb []
                                 (let [root (fmu :teacup)]
                                   (if (mget root :running?)
                                     (stop! root)
                                     (start! root))))}
            (fx/text
              (if (mget (fmu :teacup) :running?) "Stop" "Start")))

          ;; Capture widget: mounted only while running?.
          (when (mget (fmu :teacup) :running?)
            (capture))

          ;; Chart.
          (fx/expanded
            (line-chart {}
                        (chart-data
                          (mget (fmu :teacup) :samples)))))))))
