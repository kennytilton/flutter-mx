(ns tilton.fmx.example.teacup.plot
  "Dual-axis LineChart for Teacup using fl_chart.

   The chart's true Y range is [0, 5] (m/s^2 -- the xy magnitude range).
   The z series is signed in [-5, +5]; we map it linearly onto [0, 5]
   for plotting:
       z-plot(z) = (z + 5) / 2          ;; -5 -> 0, 0 -> 2.5, +5 -> 5
   Right-side tick labels show the inverse:
       z-true(v) = (v * 2) - 5

   Update story: the only-kid passed to (line-chart ...) is a cF that
   reads (mget (fmu :teacup) :samples). When samples change, the cell
   recomputes; konly-param1 stashes the value in a :sst-true cell which
   forces the wrapping widget into f/mx's stateful build path; setState
   fires; build() reruns; fl_chart receives a fresh LineChartData and
   animates."
  (:require
    ["package:flutter/widgets.dart" :as w]
    ["package:fl_chart/fl_chart.dart" :as flc]
    [tilton.fmx.api :as fx]
    [tilton.fmx.factory :refer [deftag] :as fxf]
    [tilton.mx.api :as mx
     :refer [mget cF fmu]]))

(def ^:const y-min 0.0)
(def ^:const y-max 5.0)
(def ^:const x-max-ms 10000.0)             ;; 10 s window

(defn- z->plot ^double [^double z]
  (/ (+ z 5.0) 2.0))

(defn- v->z ^double [^double v]
  (- (* v 2.0) 5.0))

(defn- spots-for [samples y-key transform]
  (mapv (fn [s]
          (flc/FlSpot (double (:t s))
                      (double (transform (y-key s)))))
        samples))

(defn- left-title-widget [value _meta]
  (w/Text (.toStringAsFixed value 1)))

(defn- right-title-widget [value _meta]
  (w/Text (.toStringAsFixed (v->z value) 1)))

(defn- bottom-title-widget [value _meta]
  (w/Text (.toStringAsFixed (/ value 1000.0) 0)))

(defn chart-data
  "Build a LineChartData from the current samples vector."
  [samples]
  (flc/LineChartData
    .minX 0.0
    .maxX x-max-ms
    .minY y-min
    .maxY y-max
    .lineBarsData
    [(flc/LineChartBarData
       .spots (spots-for samples :xy identity)
       .isCurved false
       .dotData (flc/FlDotData .show false))
     (flc/LineChartBarData
       .spots (spots-for samples :z z->plot)
       .isCurved false
       .dotData (flc/FlDotData .show false))]
    .titlesData
    (flc/FlTitlesData
      .leftTitles
      (flc/AxisTitles
        .sideTitles
        (flc/SideTitles .showTitles true
                        .reservedSize 32.0
                        .interval 1.25
                        .getTitlesWidget left-title-widget))
      .rightTitles
      (flc/AxisTitles
        .sideTitles
        (flc/SideTitles .showTitles true
                        .reservedSize 32.0
                        .interval 1.25
                        .getTitlesWidget right-title-widget))
      .bottomTitles
      (flc/AxisTitles
        .sideTitles
        (flc/SideTitles .showTitles true
                        .reservedSize 24.0
                        .interval 1000.0
                        .getTitlesWidget bottom-title-widget))
      .topTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false)))))

;;; ----- f/mx wrapper for fl_chart's LineChart -----
;;
;; LineChart is a StatefulWidget that takes its data (LineChartData,
;; non-Widget) as its first positional ctor arg. konly-param1 fits
;; this exactly: it stashes only-kid as :_param-1 (a cell with
;; :sst true, forcing stateful build), and at build time renders it as
;; the first arg. fx-render passes non-Widget values through unchanged.

(deftag fxf/konly-param1 line-chart flc/LineChart)
