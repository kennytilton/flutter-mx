(ns example.demo.teacup.sensor
  "CoreMotion (via sensors_plus) bridge for Teacup hello world.

   Two cells on the capture widget:
     :clock -- Timer.periodic fires every second. On each tick, if
               still running: decrements :secs-left on root. When
               :secs-left hits 0: stops sampling (same as Stop button).
               :on-quiesce cancels the timer on unmount.
     :sub   -- StreamSubscription accumulates samples at 10 Hz.
               :on-quiesce cancels on unmount."
  (:require
    ["dart:async" :as async]
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:sensors_plus/sensors_plus.dart" :as sp]
    [tilton.mx.cell.base :as cb]
    [tilton.mx.api :as mx
     :refer [dp cF+ mget mset! mupdate! fmu wmx-iso now-ms]]
    [tilton.fmx.api :as fx]))

(def sample-period-ms 100)                              ;; 10 Hz
(def run-duration-ms 10000)                             ;; 10 s
(def run-duration-s (quot run-duration-ms 1000))        ;; derived
(def target-count (quot run-duration-ms sample-period-ms)) ;; derived

;;; ----- listener body -----

(defn- make-listener [root last-stamp-atom stopped?-atom]
  (fn [^sp/UserAccelerometerEvent ev]
    (when-not @stopped?-atom
      (let [now  (now-ms)
            last @last-stamp-atom]
        (when (>= (- now last) sample-period-ms)
          (dp :sampling!!!)
          (reset! last-stamp-atom now)
          (let [start  (mget root :start-ms)
                t-rel  (- now start)
                x      (.-x ev)
                y      (.-y ev)
                z      (.-z ev)
                xy     (math/sqrt (+ (* x x) (* y y)))
                sample {:t t-rel :xy xy :z z}]
            (wmx-iso
              (mupdate! root :samples conj sample)
              (let [n (count (mget root :samples))]
                (when (>= n target-count)
                  (dp :sample-count-stop! :n n)
                  (reset! stopped?-atom true)
                  (mset! root :running? false))))))))))

;;; ----- capture widget -----

(defn capture []
  (fx/text
    {:style (fx/within-ctx [me ctx]
              (.-bodySmall (.-textTheme (m/Theme.of ctx))))}
    {:name  :capture

     ;; Periodic timer: ticks every second.
     ;; Each tick: if still running, decrement :secs-left.
     ;; When :secs-left reaches 0: stop sampling.
     :clock (cF+ [:on-quiesce (fn [c]
                                (when-let [^async/Timer tmr (cb/c-value c)]
                                  (dp :clock-cancelled!)
                                  (.cancel tmr)))]
              (let [root (fmu :teacup)]
                (dp :clock-starting!)
                (async/Timer.periodic (Duration .seconds 1)
                  (fn [^async/Timer tmr]
                    (wmx-iso
                      (when (mget root :running?)
                        (let [remaining (dec (mget root :secs-left))]
                          (dp :clock-tick! :secs-left remaining)
                          (mset! root :secs-left remaining)
                          (when (<= remaining 0)
                            (dp :clock-stopping!)
                            (.cancel tmr)
                            (mset! root :running? false)))))))))

     ;; Stream subscription: accumulates samples at 10 Hz.
     :sub   (cF+ [:on-quiesce (fn [c]
                                (when-let [^async/StreamSubscription sub (cb/c-value c)]
                                  (dp :sub-cancelled!)
                                  (.cancel sub)))]
              (let [last-stamp (atom 0)
                    stopped?   (atom false)
                    root       (fmu :teacup)
                    stream     (sp/userAccelerometerEventStream
                                 .samplingPeriod
                                 (Duration .milliseconds sample-period-ms))]
                (dp :sensor-subscribing!)
                (.listen stream
                  (make-listener root last-stamp stopped?))))}
    "capturing..."))
