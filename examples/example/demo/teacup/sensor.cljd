(ns tilton.fmx.example.teacup.sensor
  "CoreMotion (via sensors_plus) bridge for Teacup hello world.

   Idiom: the StreamSubscription to userAccelerometerEventStream IS the
   value of the :sub cell on a 'capture' widget. The cell has no Cell
   dependencies, so it computes once at md-awaken: build the stream,
   call .listen, return the subscription handle. :on-quiesce cancels
   when the widget is unmounted.

   The capture widget is mounted only while (mget root :running?) is
   true. Resetting :samples / :start-ms is done by the START button's
   dart-cb BEFORE it flips :running? -- not from inside any formula.

   The listener writes incoming samples to (cI :samples) on the root
   via (wmx-iso (mset! ...)), enforces 10 Hz downsampling, and triggers
   auto-stop by flipping :running? on the root. That flip causes the
   capture widget to be unmounted, which fires :on-quiesce, which
   cancels the subscription."
  (:require
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:sensors_plus/sensors_plus.dart" :as sp]
    [tilton.mx.cell.base :as cb]
    [tilton.mx.api :as mx
     :refer [cF+ mget mset! mupdate! fmu wmx-iso]]
    [tilton.mx.util :refer [now-ms]]
    [tilton.mx.base :refer [dp]]
    [tilton.fmx.api :as fx]))

(def ^:const target-count 100)
(def ^:const sample-period-ms 100)         ;; 10 Hz target
(def ^:const run-duration-ms 10000)        ;; 10 s

;;; ----- listener body -----
;;
;; Pure closure over root model and gating atoms. Called by the Dart
;; stream from outside the matrix, so writes go through wmx-iso.

(defn- make-listener [root last-stamp-atom stopped?-atom]
  (fn [ev]
    (when-not @stopped?-atom
      (let [now  (now-ms)
            last @last-stamp-atom]
        (when (>= (- now last) sample-period-ms)
          (reset! last-stamp-atom now)
          (let [start  (mget root :start-ms)
                t-rel  (- now start)
                x      (.-x ev)
                y      (.-y ev)
                z      (.-z ev)
                xy     (math/sqrt (+ (* x x) (* y y)))
                sample {:t t-rel :xy xy :z z}]
            (wmx-iso
              (mupdate! root :samples conj sample)
              (let [n (count (mget root :samples))]
                (when (or (>= n target-count)
                          (>= t-rel run-duration-ms))
                  (reset! stopped?-atom true)
                  (mset! root :running? false))))))))))

;;; ----- capture widget -----
;;
;; Mounted into the tree only when :running? is true on the root.
;; Visually a small status text. The :sub cell's value is the active
;; StreamSubscription; building that value (calling .listen) IS what
;; activates the stream. :on-quiesce cancels on unmount.

(defn capture []
  (fx/text
    {:style (fx/within-ctx [me ctx]
              (.-bodySmall (.-textTheme (m/Theme.of ctx))))}
    {:name :capture
     :sub  (cF+ [:on-quiesce (fn [c]
                               (when-let [sub (cb/c-value c)]
                                 (.cancel sub)
                                 (dp :sensor-cancelled!)))]
             ;; Pure formula: build subscription, return it as the value.
             ;; No deps -> runs once at awaken. No mset! in this body.
             (let [last-stamp (atom 0)
                   stopped?   (atom false)
                   stream     (sp/userAccelerometerEventStream
                                .samplingPeriod
                                (Duration .milliseconds sample-period-ms))]
               (dp :sensor-subscribing!)
               (.listen stream
                 (make-listener (fmu :teacup) last-stamp stopped?))))}
    "capturing..."))
