(ns example.demo.teacup.sensor
  "CoreMotion (via sensors_plus) bridge for Teacup.

   capture is always mounted. The :gyro, :clock, and :sub cells gate
   on (uformx) being non-nil. When formx appears (on :start), the cells
   activate. When formx becomes nil (on :stop or count-stop), :on-quiesce
   fires and cancels subscriptions/timers."
  (:require
    ["dart:async" :as async]
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    ["package:sensors_plus/sensors_plus.dart" :as sp]
    [tilton.mx.cell.base :as cb]
    [tilton.mx.api :as mx
     :refer [dp cF cF+ mget mset! mupdate! fmu wmx-iso now-ms]]
    [tilton.fmx.api :as fx]
    [example.demo.teacup.util :refer [uformx]]))

(def sample-period-ms 100)
(def run-duration-ms 10000)
(def run-duration-s  (quot run-duration-ms 1000))
(def target-count    (quot run-duration-ms sample-period-ms))

(defn- make-listener [formx last-stamp-atom gyro-atom]
  (fn [^sp/UserAccelerometerEvent ev]
    (let [now  (now-ms)
          last @last-stamp-atom]
      (when (>= (- now last) sample-period-ms)
        (reset! last-stamp-atom now)
        (let [start  (mget formx :start-ms)
              t-rel  (- now start)
              ax     (.-x ev)
              ay     (.-y ev)
              az     (.-z ev)
              xy     (math/sqrt (+ (* ax ax) (* ay ay)))
              g      @gyro-atom
              gx     (if g (.-x ^sp/GyroscopeEvent g) 0.0)
              gy     (if g (.-y ^sp/GyroscopeEvent g) 0.0)
              gz     (if g (.-z ^sp/GyroscopeEvent g) 0.0)
              gxz    (math/sqrt (+ (* gx gx) (* gz gz)))
              sample {:t t-rel :xy xy :az az :gz gy :gxz gxz}]
          (dp :sample :n (count (mget formx :samples)) :t-rel t-rel
              :xy xy :az az :gz gy :gxz gxz)
          (wmx-iso
            (when (mget formx :running?)
              (mupdate! formx :samples conj sample)
              (when (>= (count (mget formx :samples)) target-count)
                (dp :sample-count-stop! :n (count (mget formx :samples)))
                (mset! formx :running? false)))))))))

(defn capture []
  (let [gyro-atom (atom nil)]
    (fx/text
      {:style (fx/within-ctx [me ctx]
                (.-bodySmall (.-textTheme (m/Theme.of ctx))))}
      {:name  :capture

       :gyro  (cF+ [:on-quiesce (fn [c]
                                  (when-let [^async/StreamSubscription sub (cb/c-value c)]
                                    (dp :gyro-cancelled!)
                                    (.cancel sub)))]
                (when (uformx)
                  (dp :gyro-subscribing!)
                  (.listen (sp/gyroscopeEventStream
                             .samplingPeriod
                             (Duration .milliseconds sample-period-ms))
                    (fn [^sp/GyroscopeEvent ev]
                      (reset! gyro-atom ev)))))

       :clock (cF+ [:on-quiesce (fn [c]
                                  (when-let [^async/Timer tmr (cb/c-value c)]
                                    (dp :clock-cancelled!)
                                    (.cancel tmr)))]
                (when-let [formx (uformx)]
                  (dp :clock-starting!)
                  (async/Timer.periodic (Duration .seconds 1)
                    (fn [^async/Timer tmr]
                      (wmx-iso
                        (when (mget formx :running?)
                          (let [remaining (dec (mget formx :secs-left))]
                            (dp :clock-tick! :secs-left remaining)
                            (mset! formx :secs-left remaining)
                            (when (<= remaining 0)
                              (dp :clock-stopping!)
                              (.cancel tmr)
                              (mset! formx :running? false)))))))))

       :sub   (cF+ [:on-quiesce (fn [c]
                                  (when-let [^async/StreamSubscription sub (cb/c-value c)]
                                    (dp :sub-cancelled!)
                                    (.cancel sub)))]
                (when-let [formx (uformx)]
                  (let [last-stamp (atom 0)
                        stream     (sp/userAccelerometerEventStream
                                     .samplingPeriod
                                     (Duration .milliseconds sample-period-ms))]
                    (dp :sensor-subscribing!)
                    (.listen stream
                      (make-listener formx last-stamp gyro-atom)))))}

      (if-let [fx (uformx)]
        (if (mget fx :running?) "capturing..." "")
        ""))))
