(ns example.demo.teacup.motion
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:sensors_plus/sensors_plus.dart" :as sensors]
    ["dart:math" :as dart:math]
    [tilton.mx.api :as mx
     :refer [dp dpx cI cF cFonce mget mset! mswap! fmu wmx-iso]]
    [tilton.mx.model.core :as md]
    [tilton.fmx.api :as fx]))

;;; --- app-level accessors -----------------------------------------------

(defn app-motion []
  (mx/fmu :app-motion))

(defn motion-phase []
  (mget (app-motion) :phase))

(defn motion-samples []
  (mget (app-motion) :samples))

;;; --- sample record helpers ---------------------------------------------

(defn make-sample [t hz vt]
  {:t t :hz hz :vt vt})

;;; --- sensor subscription -----------------------------------------------

(defn start-recording! [me]
  (dp :start-recording!)
  (let [sub (.listen sensors/userAccelerometerEvents
              (fn [^sensors/UserAccelerometerEvent e]
                (wmx-iso
                  (when (= :recording (mget (app-motion) :phase))
                    (let [x  (.-x e)
                          y  (.-y e)
                          z  (.-z e)
                          hz (dart:math/sqrt (+ (* x x) (* y y)))
                          vt z
                          t  (.millisecondsSinceEpoch (DateTime/now))]
                      (mswap! (app-motion) :samples conj
                        (make-sample t hz vt)))))))]
    (mset! me :subscription sub)))

(defn stop-recording! [me]
  (dp :stop-recording!)
  (when-let [sub (mget me :subscription)]
    (.cancel sub)
    (mset! me :subscription nil)))

;;; --- motion model -------------------------------------------------------

(defn make-motion []
  (md/make
    :name        :app-motion
    :phase       (cI :idle)
    :samples     (cI [])
    :subscription (cI nil)))
