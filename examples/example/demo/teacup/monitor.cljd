(ns example.demo.teacup.monitor
  "Live monitor page: chart + capture controls."
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    [tilton.fmx.api :refer [dart-cb] :as fx]
    [tilton.mx.api :as mx
     :refer [dp mget mset! fmu]]
    [example.demo.teacup.util :refer [uformx]]
    [example.demo.teacup.plot :as plot :refer [line-chart chart-data]]))

(defn counter-label [samples running? secs-left]
  (let [n (count samples)]
    (cond
      running?    (str n " samples  |  " secs-left "s remaining")
      (zero? n)   "Press Start"
      :else       (str "Captured " n " samples"))))

(defn monitor-page []
  (fx/safe-area
    (fx/column
      {:mainAxisAlignment  m/MainAxisAlignment.spaceEvenly
       :crossAxisAlignment m/CrossAxisAlignment.stretch}

      (fx/text
        {:style     (p/TextStyle .fontSize 18.0 .color m/Colors.black)
         :textAlign m/TextAlign.center}
        (if-let [fx (uformx)]
          (counter-label
            (mget fx :samples)
            (mget fx :running?)
            (mget fx :secs-left))
          "Press Start"))

      (fx/elevated-button
        {:onPressed (dart-cb []
                      (let [root (fmu :teacup)
                            fx   (uformx)]
                        (if (and fx (mget fx :running?))
                          (mset! root :event :stop)
                          (mset! root :event :start))))}
        (fx/text
          (if-let [fx (uformx)]
            (if (mget fx :running?) "Stop" "Start")
            "Start")))

      (fx/expanded
        (line-chart {}
          (chart-data
            (if-let [fx (uformx)]
              (mget fx :samples)
              [])))))))
