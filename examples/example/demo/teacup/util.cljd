(ns example.demo.teacup.util
  "Shared utilities for Teacup."
  (:require
    [tilton.mx.api :as mx
     :refer [mget dp fmu]]))

(defmacro uformx []
  `(let [tc# (fmu :teacup)]
     (dp :ufx-sees-tc tc#)
     (mget tc# :formx)))

