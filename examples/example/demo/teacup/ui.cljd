(ns example.demo.teacup.ui
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:flutter/painting.dart" :as p]
    ["dart:math" :as dart:math]
    ["package:fl_chart/fl_chart.dart" :as fl]
    [tilton.mx.api :as mx
     :refer [dp dpx cI cF cFonce mget mset! mswap! fmu mav wmx-iso]]
    [tilton.fmx.api :as fx
     :refer [scaffold app-bar text center column row
             container expanded padding material-app
             icon-button icon ignore-pointer opacity dart-cb]]
    [example.demo.teacup.motion :as motion
     :refer [app-motion motion-phase motion-samples
             make-motion start-recording! stop-recording!]]))

;;; --- button row ---------------------------------------------------------

(defn tc-button [label color enabled? on-press]
  (ignore-pointer {:ignoring (not enabled?)}
    (opacity {:opacity (if enabled? 1.0 0.3)}
      (container
        {:margin (m/EdgeInsets.symmetric .horizontal 12)}
        (m/ElevatedButton.
          .onPressed (when enabled? on-press)
          .style (m/ElevatedButton.styleFrom
                   .backgroundColor color)
          .child (m/Text label
                   .style (p/TextStyle
                            .color m/Colors.white
                            .fontSize 18.0)))))))

(defn button-row []
  (let [phase (motion-phase)]
    (row {:mainAxisAlignment m/MainAxisAlignment.center}
      (tc-button "Start" m/Colors.green
        (= phase :idle)
        (dart-cb []
          (wmx-iso
            (mset! (app-motion) :samples [])
            (mset! (app-motion) :phase :recording)
            (start-recording! (app-motion)))))
      (tc-button "Stop" m/Colors.red
        (= phase :recording)
        (dart-cb []
          (wmx-iso
            (stop-recording! (app-motion))
            (mset! (app-motion) :phase :stopped))))
      (tc-button "Done" m/Colors.blue
        (= phase :stopped)
        (dart-cb []
          (wmx-iso
            (mset! (app-motion) :phase :idle)))))))

;;; --- plots --------------------------------------------------------------

(defn samples->spots [samples key-fn]
  (when (seq samples)
    (let [t0 (:t (first samples))]
      (map-indexed
        (fn [i s]
          (fl/FlSpot.
            (/ (- (:t s) t0) 1000.0)
            (double (key-fn s))))
        samples))))

(defn line-chart [samples key-fn color title]
  (let [spots (samples->spots samples key-fn)]
    (container
      {:height  200
       :padding (m/EdgeInsets.all 16.0)}
      (column {:crossAxisAlignment m/CrossAxisAlignment.start}
        (text {:style (p/TextStyle .fontSize 14.0 .fontWeight m/FontWeight.bold)}
          title)
        (expanded
          (fl/LineChart.
            (fl/LineChartData.
              .lineBarsData
              [(fl/LineChartBarData.
                 .spots (or spots [])
                 .isCurved false
                 .color color
                 .barWidth 2.0
                 .dotData (fl/FlDotData. .show false))]
              .titlesData
              (fl/FlTitlesData.
                .bottomTitles
                (fl/AxisTitles.
                  .sideTitles (fl/SideTitles.
                                .showTitles true
                                .reservedSize 28))
                .leftTitles
                (fl/AxisTitles.
                  .sideTitles (fl/SideTitles.
                                .showTitles true
                                .reservedSize 40))
                .topTitles   (fl/AxisTitles. .sideTitles (fl/SideTitles. .showTitles false))
                .rightTitles (fl/AxisTitles. .sideTitles (fl/SideTitles. .showTitles false)))
              .borderData (fl/FlBorderData. .show true)
              .gridData  (fl/FlGridData. .show true))))))))

(defn plots []
  (let [samples (motion-samples)
        phase   (motion-phase)]
    (when (and (= phase :stopped) (seq samples))
      (column {}
        (line-chart samples :hz m/Colors.green "Hz — horizontal magnitude (m/s²)")
        (line-chart samples :vt m/Colors.red   "Vt — vertical acceleration (m/s²)")))))

;;; --- root app -----------------------------------------------------------

(defn make-app []
  (material-app {}
    {:name :app}
    (make-motion)
    (scaffold
      {:appBar (app-bar {:title (m/Text "Teacup")})}
      (column
        {:mainAxisAlignment m/MainAxisAlignment.start}
        (padding {:padding (m/EdgeInsets.only .top 32.0 .bottom 24.0)}
          (button-row))
        (or (plots)
          (center
            (text {:style (p/TextStyle .color m/Colors.grey .fontSize 16.0)}
              "Press Start to begin recording.")))))))
