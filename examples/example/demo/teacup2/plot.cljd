(ns example.demo.teacup2.plot
  "Temporary horizontal-motion LineChart for Teacup2.
     solid black  -- horizontal motion aggregate
     black dashes -- horizontal acceleration
     purple       -- yaw-rate change"
  (:require
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    [tilton.fmx.factory :refer [deftag konly-param1] :as fxf]
    [tilton.mx.api :as mx
     :refer [mget cF fmu]]
    [example.demo.teacup2.sensor :as sensor]))

(deftag tilton.fmx.factory/konly-param1 line-chart flc/LineChart)

(def one-sec-pix-width 48.0)
(def bottom-title-interval-ms 5000.0)
(def y-margin 1.2)
(def yaw-display-ma-window-ms 1000.0)
(def lean-display-ma-window-ms 1000.0)
(def bob-display-ma-window-ms 750.0)
(def display-ma-warmup-ms 1000.0)
(def bob-display-scale-in-s2 40.0)
(def hz-motion-display-scale 0.002)
(def yaw-rate-change-display-scale 0.25)

(defn- spots-for [samples y-key]
  (mapv (fn [s]
          (flc/FlSpot (double (get s :t))
                      (double (or (get s y-key) 0.0))))
        samples))

(defn- baseline-for [samples y-key]
  (if-let [sample (first samples)]
    (double (or (get sample y-key) 0.0))
    0.0))

(defn- relative-value [sample y-key baseline]
  (- (or (get sample y-key) 0.0) baseline))

(defn- relative-spots-for [samples y-key]
  (let [baseline (baseline-for samples y-key)]
    (mapv (fn [s]
            (flc/FlSpot (double (get s :t))
                        (double (relative-value s y-key baseline))))
      samples)))

(defn- scaled-spots-for [samples y-key scale]
  (mapv (fn [s]
          (flc/FlSpot (double (get s :t))
                      (double (/ (or (get s y-key) 0.0) scale))))
    samples))

(defn- multiplied-spots-for [samples y-key scale]
  (mapv (fn [s]
          (flc/FlSpot (double (get s :t))
                      (double (* (or (get s y-key) 0.0) scale))))
    samples))

(defn- rolling-average-values
  ([samples window-ms value-fn]
   (rolling-average-values samples window-ms value-fn false))
  ([samples window-ms value-fn full-window-only?]
   (loop [remaining samples
          window []
          sum 0.0
          values []]
     (if-let [sample (first remaining)]
       (let [t (double (get sample :t))
             t-min (- t window-ms)
             v (double (value-fn sample))
             window+ (conj window [sample v])
             sum+ (+ sum v)
             [window* sum*]
             (loop [w window+
                    s sum+]
               (if (and (seq w)
                     (< (double (get (first (first w)) :t)) t-min))
                 (recur (subvec w 1) (- s (second (first w))))
                 [w s]))
             n (count window*)]
         (recur (rest remaining)
           window*
           sum*
           (if (and full-window-only?
                 (< t window-ms))
             values
             (conj values (if (pos? n) (/ sum* n) 0.0)))))
       values))))

(defn- yaw-display-values [samples]
  (rolling-average-values samples yaw-display-ma-window-ms
    #(* (or (get % :yaw-accel) 0.0)
       yaw-rate-change-display-scale)
    true))

(defn- lean-display-values [samples]
  (rolling-average-values samples lean-display-ma-window-ms
    #(/ (or (get % :lean-deg) 0.0) 90.0)))

(defn- bob-display-values [samples]
  (rolling-average-values samples bob-display-ma-window-ms
    #(/ (or (get % :bob-in-s2)
          (.abs ^num (or (get % :vertical-accel-in-s2) 0.0)))
       bob-display-scale-in-s2)))

(defn- yaw-display-spots-for [samples]
  (mapv (fn [s yaw]
          (flc/FlSpot (double (get s :t))
                      (double yaw)))
    (filter #(>= (double (get % :t)) yaw-display-ma-window-ms) samples)
    (yaw-display-values samples)))

(defn- lean-display-spots-for [samples]
  (mapv (fn [s lean]
          (flc/FlSpot (double (get s :t))
                      (double lean)))
    samples
    (lean-display-values samples)))

(defn- bob-display-spots-for [samples]
  (mapv (fn [s bob]
          (flc/FlSpot (double (get s :t))
                      (double bob)))
    samples
    (bob-display-values samples)))

(defn- y-values [samples show]
  (let [hz-motion-base (baseline-for samples :hz-motion)
        hz-accel-base  (baseline-for samples :hz-accel)]
    (concat
      (when (get show :hz?)
        (concat
          (map #(relative-value % :hz-motion hz-motion-base) samples)
          (map #(relative-value % :hz-accel hz-accel-base) samples)))
      (when (get show :yaw?)
        (yaw-display-values samples))
      (when (get show :lean?)
        (lean-display-values samples))
      (when (get show :bob?)
        (bob-display-values samples)))))

(defn- y-bounds [samples show]
  [-1.0 1.0])

(defn ^m/Widget bottom-title-widget [^double value ^flc/TitleMeta _meta]
  (w/Text (.toStringAsFixed (/ value 1000.0) 0)))

(defn ^flc/FlDotPainter dot-painter
  [^flc/FlSpot _spot
   ^double _x-pct
   ^flc/LineChartBarData _bar
   ^int _idx]
  (flc/FlDotCirclePainter
    .radius 2.0
    .color m/Colors.black
    .strokeWidth 0.0))

(defn latest-t-ms [samples]
  (if-let [sample (last samples)]
    (double (get sample :t))
    0.0))

(defn- display-window-ms [chart-width]
  (* 1000.0 (/ chart-width one-sec-pix-width)))

(defn chart-window [samples compressed? chart-width]
  (let [latest (latest-t-ms samples)
        window-ms (display-window-ms chart-width)]
    (if compressed?
      [0.0 (max 1.0 latest)]
      [(max 0.0 (- latest window-ms))
       (max window-ms latest)])))

(defn- display-samples [samples compressed? chart-width]
  (if compressed?
    samples
    (let [latest (latest-t-ms samples)
          min-t  (max 0.0 (- latest (display-window-ms chart-width) display-ma-warmup-ms))]
      (vec (filter #(>= (double (get % :t)) min-t) samples)))))

(defn expanded-chart-width [samples chart-width]
  (max chart-width
    (* one-sec-pix-width
      (/ (latest-t-ms samples) 1000.0))))

(defn stopped-chart-width [samples]
  (* one-sec-pix-width
    (/ (latest-t-ms samples) 1000.0)))

(defn- default-chart-width []
  (* one-sec-pix-width 10.0))

(defn chart-data
  ([samples running?] (chart-data samples running? true {:lean? true :bob? false :hz? false :yaw? true}))
  ([samples compressed? chart-width] (chart-data samples compressed? chart-width {:lean? true :bob? false :hz? false :yaw? true}))
  ([samples mode width-or-stopped-full? show]
   (let [new-api? (number? width-or-stopped-full?)
         compressed? (if new-api?
                       mode
                       (and (not mode) width-or-stopped-full?))
         chart-width (if new-api?
                       width-or-stopped-full?
                       (default-chart-width))
         [min-x max-x] (chart-window samples compressed? chart-width)
         plot-samples (display-samples samples compressed? chart-width)
         [min-y max-y] (y-bounds plot-samples show)]
    (flc/LineChartData
	      .minX min-x
	      .maxX max-x
	      .minY min-y
	      .maxY max-y
	    .extraLinesData
	    (flc/ExtraLinesData
	      .horizontalLines [(flc/HorizontalLine
	                          .y 0.0
	                          .color m/Colors.black
	                          .strokeWidth 1.0)]
	      .extraLinesOnTop false)
	    .clipData (flc/FlClipData.none)
	    .lineTouchData (flc/LineTouchData .enabled false)
	    .lineBarsData
        (vec
          (concat
            (when (get show :hz?)
              [(flc/LineChartBarData
                 .spots (multiplied-spots-for plot-samples :hz-motion hz-motion-display-scale)
                 .color m/Colors.blue
                 .barWidth 2.0
                 .isCurved false
                 .dotData (flc/FlDotData .show false))])
            (when (get show :lean?)
              [(flc/LineChartBarData
                 .spots (lean-display-spots-for plot-samples)
                 .color m/Colors.orange
                 .barWidth 2.0
                 .isCurved true
                 .dotData (flc/FlDotData .show false))])
            (when (get show :yaw?)
              [(flc/LineChartBarData
                 .spots (yaw-display-spots-for plot-samples)
                 .color m/Colors.purple
                 .barWidth 2.0
                 .isCurved true
                 .dotData (flc/FlDotData .show false))])
            (when (get show :bob?)
              [(flc/LineChartBarData
                 .spots (bob-display-spots-for plot-samples)
                 .color m/Colors.red
                 .barWidth 2.0
                 .isCurved true
                 .dotData (flc/FlDotData .show false))])))
    .titlesData
    (flc/FlTitlesData
      .leftTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false))
      .rightTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false))
      .bottomTitles
      (flc/AxisTitles
        .sideTitles
	        (flc/SideTitles .showTitles true
	                        .reservedSize 24.0
	                        .interval bottom-title-interval-ms
	                        .getTitlesWidget bottom-title-widget))
      .topTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false)))))))
