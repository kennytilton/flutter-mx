(ns example.demo.teacup2.plot
  "Temporary horizontal-motion LineChart for Teacup2.
     solid black  -- horizontal motion aggregate
     black dashes -- horizontal acceleration
     black dots   -- yaw"
  (:require
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    [tilton.fmx.factory :refer [deftag konly-param1] :as fxf]
    [tilton.mx.api :as mx
     :refer [mget cF fmu]]
    [example.demo.teacup2.sensor :as sensor]))

(deftag tilton.fmx.factory/konly-param1 line-chart flc/LineChart)

(def live-window-ms 10000.0)
(def stopped-window-width 900.0)
(def bottom-title-interval-ms 5000.0)
(def y-margin 1.2)

(defn- spots-for [samples y-key]
  (mapv (fn [s]
          (flc/FlSpot (double (get s :t))
                      (double (or (get s y-key) 0.0))))
        samples))

(defn- baseline-for [samples y-key]
  (if-let [sample (first samples)]
    (double (or (get sample y-key) 0.0))
    0.0))

(defn- relative-value [sample y-key baseline]
  (- (or (get sample y-key) 0.0) baseline))

(defn- relative-spots-for [samples y-key]
  (let [baseline (baseline-for samples y-key)]
    (mapv (fn [s]
            (flc/FlSpot (double (get s :t))
                        (double (relative-value s y-key baseline))))
      samples)))

(defn- scaled-spots-for [samples y-key scale]
  (mapv (fn [s]
          (flc/FlSpot (double (get s :t))
                      (double (/ (or (get s y-key) 0.0) scale))))
    samples))

(defn- y-values [samples show]
  (let [hz-motion-base (baseline-for samples :hz-motion)
        hz-accel-base  (baseline-for samples :hz-accel)
        yaw-base       (baseline-for samples :yaw-score)]
    (concat
      (when (get show :hz?)
        (concat
          (map #(relative-value % :hz-motion hz-motion-base) samples)
          (map #(relative-value % :hz-accel hz-accel-base) samples)))
      (when (get show :yaw?)
        (map #(relative-value % :yaw-score yaw-base) samples))
      (when (get show :lean?)
        (map #(/ (or (get % :lean-deg) 0.0) 90.0) samples))
      (when (get show :bob?)
        (map #(or (get % :vertical-accel-in-s2) 0.0) samples)))))

(defn- y-bounds [samples show]
  [-1.0 1.0])

(defn ^m/Widget bottom-title-widget [^double value ^flc/TitleMeta _meta]
  (w/Text (.toStringAsFixed (/ value 1000.0) 0)))

(defn ^flc/FlDotPainter dot-painter
  [^flc/FlSpot _spot
   ^double _x-pct
   ^flc/LineChartBarData _bar
   ^int _idx]
  (flc/FlDotCirclePainter
    .radius 2.0
    .color m/Colors.black
    .strokeWidth 0.0))

(defn latest-t-ms [samples]
  (if-let [sample (last samples)]
    (double (get sample :t))
    0.0))

(defn chart-window [samples running? stopped-full?]
  (let [latest (latest-t-ms samples)]
    (cond
      running?
      [(max 0.0 (- latest live-window-ms))
       (max live-window-ms latest)]

      stopped-full?
      [0.0 (max 1.0 latest)]

      :else
      [(max 0.0 (- latest live-window-ms))
       (max live-window-ms latest)])))

(defn stopped-chart-width [samples]
  (* stopped-window-width
    (/ (latest-t-ms samples)
      live-window-ms)))

(defn chart-data
  ([samples running?] (chart-data samples running? true {:lean? true :bob? false :hz? false :yaw? false}))
  ([samples running? stopped-full?] (chart-data samples running? stopped-full? {:lean? true :bob? false :hz? false :yaw? false}))
  ([samples running? stopped-full? show]
   (let [[min-x max-x] (chart-window samples running? stopped-full?)
        [min-y max-y] (y-bounds samples show)]
    (flc/LineChartData
	      .minX min-x
	      .maxX max-x
	      .minY min-y
	      .maxY max-y
	    .extraLinesData
	    (flc/ExtraLinesData
	      .horizontalLines [(flc/HorizontalLine
	                          .y 0.0
	                          .color m/Colors.black
	                          .strokeWidth 1.0)]
	      .extraLinesOnTop false)
	    .clipData (flc/FlClipData.none)
	    .lineBarsData
        (vec
          (concat
            (when (get show :hz?)
              [(flc/LineChartBarData
                 .spots (relative-spots-for samples :hz-motion)
                 .color m/Colors.black
                 .barWidth 1.5
                 .isCurved false
                 .dotData (flc/FlDotData .show false))
               (flc/LineChartBarData
                 .spots (relative-spots-for samples :hz-accel)
                 .color m/Colors.black
                 .barWidth 1.25
                 .isCurved false
                 .dashArray [5 4]
                 .dotData (flc/FlDotData .show false))])
            (when (get show :lean?)
              [(flc/LineChartBarData
                 .spots (scaled-spots-for samples :lean-deg 90.0)
                 .color m/Colors.orange
                 .barWidth 2.0
                 .isCurved false
                 .dotData (flc/FlDotData .show false))])
            (when (get show :bob?)
              [(flc/LineChartBarData
                 .spots (spots-for samples :vertical-accel-in-s2)
                 .color m/Colors.red
                 .barWidth 2.0
                 .isCurved false
                 .dotData (flc/FlDotData .show false))])
            (when (get show :yaw?)
              [(flc/LineChartBarData
                 .spots (relative-spots-for samples :yaw-score)
                 .color m/Colors.black
                 .barWidth 0.0
                 .isCurved false
                 .dotData (flc/FlDotData .show true
                                            .getDotPainter dot-painter))])))
    .titlesData
    (flc/FlTitlesData
      .leftTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false))
      .rightTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false))
      .bottomTitles
      (flc/AxisTitles
        .sideTitles
	        (flc/SideTitles .showTitles true
	                        .reservedSize 24.0
	                        .interval bottom-title-interval-ms
	                        .getTitlesWidget bottom-title-widget))
      .topTitles
      (flc/AxisTitles
        .sideTitles (flc/SideTitles .showTitles false)))))))
