(ns example.demo.teacup2.persist
  "Hive-backed settings persistence for Teacup2."
  (:require
    ["package:hive_flutter/hive_flutter.dart" :as hv]
    [cljd.string :as str]))

(def settings-box-name "teacup2-settings")
(def sensor-source-key "sensor-source")
(def sensor-location-key "sensor-location")
(def selected-ble-remote-id-key "selected-ble-remote-id")
(def lean-tolerance-key "lean-tolerance-deg")
(def display-series-key "display-series")
(def ghost-session-paths-key "ghost-session-paths")
(def chart-y-scale-key "chart-y-scale")

(def sensor-location-options [:head :chest :waist :hip])
(def default-sensor-location :waist)

(defn normalize-sensor-location [location]
  (let [location (if (string? location)
                   (keyword location)
                   location)]
    (if (some #{location} sensor-location-options)
      location
      default-sensor-location)))

(def default-display-series
  {:lean? false
   :bob?  true
   :hz?   false
   :yaw?  true
   :summary? true})

(def +DB+ (atom nil))

(defn ^hv/Box? DB [] @+DB+)
(defn ^hv/Box? DB! [db] (reset! +DB+ db))

(defn ^:async open-settings-box []
  (-> hv/Hive hv/HiveX .initFlutter await)
  (-> hv/Hive (.openBox settings-box-name)))

(defn sensor-source-read [^hv/Box db]
  (case (.get db sensor-source-key)
    "witmotion-ble" :witmotion-ble
    "iphone" :iphone
    nil))

(defn sensor-source-write! [^hv/Box db source]
  (.put db sensor-source-key
    (case source
      :witmotion-ble "witmotion-ble"
      :iphone "iphone"
	  (name source)))
  source)

(defn sensor-location-read [^hv/Box db]
  (normalize-sensor-location (.get db sensor-location-key)))

(defn sensor-location-write! [^hv/Box db location]
  (let [location (normalize-sensor-location location)]
    (.put db sensor-location-key (name location))
    location))

(defn selected-ble-remote-id-read [^hv/Box db]
  (.get db selected-ble-remote-id-key))

(defn selected-ble-remote-id-write! [^hv/Box db remote-id]
  (if remote-id
    (.put db selected-ble-remote-id-key remote-id)
    (.delete db selected-ble-remote-id-key))
  remote-id)

(defn lean-tolerance-read [^hv/Box db]
  (.get db lean-tolerance-key))

(defn lean-tolerance-write! [^hv/Box db tolerance-deg]
  (.put db lean-tolerance-key tolerance-deg)
  tolerance-deg)

(defn display-series-read [^hv/Box db]
  (if-let [s (.get db display-series-key)]
	    {:lean? (.contains ^String s "lean")
	     :bob?  (.contains ^String s "bob")
	     :hz?   (.contains ^String s "hz")
	     :yaw?  (.contains ^String s "yaw")
	     :summary? (not (.contains ^String s "summary-off"))}
	    default-display-series))

(defn display-series-write! [^hv/Box db display-series]
  (.put db display-series-key
    (str
	      (when (get display-series :lean?) "lean,")
	      (when (get display-series :bob?) "bob,")
	      (when (get display-series :hz?) "hz,")
	      (when (get display-series :yaw?) "yaw,")
	      (when-not (get display-series :summary?) "summary-off,")))
	  display-series)

(defn chart-y-scale-read [^hv/Box db]
  (if-let [scale (.get db chart-y-scale-key)]
    (if (number? scale)
      (double scale)
      1.0)
    1.0))

(defn chart-y-scale-write! [^hv/Box db scale]
  (.put db chart-y-scale-key scale)
  scale)

(defn ghost-session-paths-read [^hv/Box db]
  (if-let [s (.get db ghost-session-paths-key)]
    (vec (filter #(not (.-isEmpty ^String %))
           (.split ^String s "\n")))
    []))

(defn ghost-session-paths-write! [^hv/Box db paths]
  (let [paths (vec paths)]
    (if (seq paths)
      (.put db ghost-session-paths-key
        (str/join "\n" paths))
      (.delete db ghost-session-paths-key))
    paths))
