(ns example.demo.teacup2.summary
  "Summary stats page."
  (:require
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    [tilton.fmx.api :as fx]
    [tilton.mx.api :as mx
     :refer [mget fmu]]
    [example.demo.teacup2.util :refer [uformx]]))

(defn- mean [xs]
  (if (empty? xs)
    0.0
    (/ (reduce + xs) (count xs))))

(defn- std-dev [xs]
  (if (< (count xs) 2)
    0.0
    (let [m (mean xs)
          variance (mean (map #(let [d (- % m)] (* d d)) xs))]
      (math/sqrt variance))))

(defn- stat-line [label value unit]
  (str label ": " (.toStringAsFixed ^num value 1)
    (if (empty? unit) "" (str " " unit))))

(defn- stat-line-int [label value unit]
  (str label ": " (.round ^num value) " " unit))

(defn- pct [part total]
  (if (zero? total)
    0.0
    (* 100.0 (/ part total))))

(defn- compute-stats [samples lean-tolerance-deg]
  (if (empty? samples)
    nil
    (let [leans (map #(get % :lean-deg) samples)]
      {:lean (mean leans)
       :lean-std-dev (std-dev leans)
       :lean-pct (pct (count (filter #(> % lean-tolerance-deg) leans))
                   (count leans))
       :sudden-change (mean (map #(get % :combined-sudden-change) samples))})))

(defn summary-page []
  (fx/safe-area
    (fx/column
      {:mainAxisAlignment  m/MainAxisAlignment.center
       :crossAxisAlignment m/CrossAxisAlignment.center}
      (fx/text
        {:style (p/TextStyle .fontSize 22.0 .color m/Colors.black)}
        (if-let [fx (uformx)]
          (let [root (fmu :teacup2)
                samples (mget fx :samples)
                lean-tolerance-deg (mget root :lean-tolerance-deg)]
            (if-let [s (compute-stats samples lean-tolerance-deg)]
              (str (stat-line "LEAN" (get s :lean) "°") "\n"
                   (stat-line "LEAN STD DEV" (get s :lean-std-dev) "°") "\n"
                   (stat-line "LEAN SAMPLES" (get s :lean-pct) "%") "\n"
                   (stat-line "SUDDEN CHANGE" (get s :sudden-change) ""))
              "No samples yet"))
          "No data yet")))))
