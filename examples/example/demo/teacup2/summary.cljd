(ns example.demo.teacup2.summary
  "Summary stats page."
  (:require
    ["dart:math" :as math]
	    ["package:flutter/material.dart" :as m]
	    ["package:flutter/widgets.dart" :as w]
	    ["package:flutter/painting.dart" :as p]
	    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
		    [tilton.fmx.api :as fx]
	    [tilton.mx.api :as mx
	     :refer [dp dpx mget fmu]]
    [example.demo.teacup2.util :refer [uformx]]))

(defn- mean [xs]
  (if (empty? xs)
    0.0
    (/ (reduce + xs) (count xs))))

(defn- std-dev [xs]
  (if (< (count xs) 2)
    0.0
    (let [m (mean xs)
          variance (mean (map #(let [d (- % m)] (* d d)) xs))]
      (math/sqrt variance))))

(defn- fmt1 [value]
  (.toStringAsFixed ^num value 1))

(defn- numeric-values [xs]
  (vec (filter number? xs)))

(defn- trim-10 [xs]
  (let [sorted (vec (sort xs))
        n (count sorted)
        drop-n (quot n 10)
        keep-n (- n (* 2 drop-n))]
    (if (pos? keep-n)
      (subvec sorted drop-n (+ drop-n keep-n))
      [])))

(defn- measure-stats [xs]
  (let [values (numeric-values xs)
        trimmed (trim-10 values)]
    (if (empty? trimmed)
      {:n (count values)
       :kept 0
       :min 0.0
       :max 0.0
       :avg 0.0
       :std 0.0}
      {:n (count values)
       :kept (count trimmed)
       :min (reduce min trimmed)
       :max (reduce max trimmed)
       :avg (mean trimmed)
       :std (std-dev trimmed)})))

(defn- pct-line [label value]
  (str label ": " (fmt1 value) "%"))

(defn- stat-cell [text]
  (m/DataCell (m/Text text)))

(defn- stat-column [label]
  (m/DataColumn .label (m/Text label)))

(defn- stat-row [label stats unit]
  (m/DataRow
    .cells [(stat-cell label)
            (stat-cell (fmt1 (get stats :min)))
            (stat-cell (fmt1 (get stats :max)))
            (stat-cell (fmt1 (get stats :avg)))
            (stat-cell (fmt1 (get stats :std)))
            (stat-cell unit)
            (stat-cell (str (get stats :kept) "/" (get stats :n)))]))

(defn- stats-grid [s]
  (m/DataTable
    .headingTextStyle (p/TextStyle .fontWeight p/FontWeight.bold
                        .fontSize 14.0
                        .color m/Colors.black)
    .dataTextStyle (p/TextStyle .fontSize 14.0 .color m/Colors.black)
    .columns [(stat-column "Measure")
              (stat-column "Min")
              (stat-column "Max")
              (stat-column "Avg")
              (stat-column "SD")
              (stat-column "Unit")
              (stat-column "N")]
    .rows [(stat-row "Lean" (get s :lean) "deg")
           (stat-row "Bob" (get s :bob) "in/s2")
           (stat-row "Yaw accel" (get s :yaw) "rad/s2")
           (stat-row "Hz motion" (get s :hz) "in/s2")]))

(defn- stat-line-int [label value unit]
  (str label ": " (.round ^num value) " " unit))

(defn- pct [part total]
  (if (zero? total)
    0.0
    (* 100.0 (/ part total))))

(defn- compute-stats [samples lean-tolerance-deg]
  (if (empty? samples)
    nil
    (let [leans (map #(get % :lean-deg) samples)
          bobs  (map #(or (get % :bob-in-s2)
	                       (.abs ^num (or (get % :vertical-accel-in-s2) 0.0))) samples)
          yaw-accels (map #(get % :yaw-accel) samples)
          hz-motions (map #(get % :hz-motion) samples)
          lean-stats (measure-stats leans)
          bob-stats (measure-stats bobs)
          yaw-stats (measure-stats yaw-accels)
          hz-stats (measure-stats hz-motions)]
      (dpx :lean-summary
        :n (count samples)
        :lean lean-stats
        :bob bob-stats
        :yaw yaw-stats
        :hz hz-stats
        :tol (fmt1 lean-tolerance-deg))
      {:lean lean-stats
       :bob bob-stats
       :yaw yaw-stats
       :hz hz-stats
       :lean-pct (pct (count (filter #(> % lean-tolerance-deg) leans))
                   (count leans))})))

(defn- summary-content [s]
  (fx/column
    {:crossAxisAlignment m/CrossAxisAlignment.start}
    (fx/text
      {:style (p/TextStyle .fontSize 16.0 .color m/Colors.black)}
      "Trimmed stats: dropping low/high 10%")
    (m/SingleChildScrollView
      .scrollDirection w/Axis.horizontal
      .child (stats-grid s))
    (fx/text
      {:style (p/TextStyle .fontSize 16.0 .color m/Colors.black)}
      (pct-line "Lean over tolerance" (get s :lean-pct)))))

(defn summary-page []
  (fx/safe-area
    (fx/column
	      {:mainAxisAlignment  m/MainAxisAlignment.center
	       :crossAxisAlignment m/CrossAxisAlignment.center}
		      (fx/padding
		        {:padding (m/EdgeInsets.all 24.0)}
		        (if-let [fx (uformx)]
		          (let [root (fmu :teacup2)
		                samples (mget fx :samples)
		                lean-tolerance-deg (mget root :lean-tolerance-deg)]
		            (if-let [s (compute-stats samples lean-tolerance-deg)]
		              (do
		                (dp :summary s)
		                (summary-content s))
		              (m/Text "No samples yet")))
		          (m/Text "No data yet"))))))
