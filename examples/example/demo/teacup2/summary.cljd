(ns example.demo.teacup2.summary
  "Summary stats page."
  (:require
    ["dart:math" :as math]
	    ["package:flutter/material.dart" :as m]
	    ["package:flutter/widgets.dart" :as w]
	    ["package:flutter/painting.dart" :as p]
	    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
		    [tilton.fmx.api :as fx]
	    [tilton.mx.api :as mx
	     :refer [dp dpx mget fmu]]
    [example.demo.teacup2.util :refer [uformx]]))

(defn- mean [xs]
  (if (empty? xs)
    0.0
    (/ (reduce + xs) (count xs))))

(defn- std-dev [xs]
  (if (< (count xs) 2)
    0.0
    (let [m (mean xs)
          variance (mean (map #(let [d (- % m)] (* d d)) xs))]
      (math/sqrt variance))))

(defn- stat-line [label value unit]
  (str label ": " (.toStringAsFixed ^num value 1)
    (if (empty? unit) "" (str " " unit))))

(defn- stat-line-int [label value unit]
  (str label ": " (.round ^num value) " " unit))

(defn- pct [part total]
  (if (zero? total)
    0.0
    (* 100.0 (/ part total))))

(defn- compute-stats [samples lean-tolerance-deg]
  (if (empty? samples)
    nil
    (let [leans (map #(get % :lean-deg) samples)
          bobs  (map #(or (get % :bob-in-s2)
                       (.abs ^num (or (get % :vertical-accel-in-s2) 0.0))) samples)]
      (dpx :lean-summary
        :n (count samples)
        :first (.toStringAsFixed ^num (first leans) 1)
        :last (.toStringAsFixed ^num (last leans) 1)
        :min (.toStringAsFixed ^num (reduce min leans) 1)
        :max (.toStringAsFixed ^num (reduce max leans) 1)
        :avg (.toStringAsFixed ^num (mean leans) 1)
        :std (.toStringAsFixed ^num (std-dev leans) 1)
        :tol (.toStringAsFixed ^num lean-tolerance-deg 1))
	      {:lean-min (reduce min leans)
	       :lean (mean leans)
	       :lean-max (reduce max leans)
	       :lean-std-dev (std-dev leans)
	       :lean-pct (pct (count (filter #(> % lean-tolerance-deg) leans))
	                   (count leans))
	       :bob (mean bobs)})))

(defn summary-page []
  (fx/safe-area
    (fx/column
      {:mainAxisAlignment  m/MainAxisAlignment.center
       :crossAxisAlignment m/CrossAxisAlignment.center}
	      (fx/padding
	        {:padding (m/EdgeInsets.all 24.0)}
	        (fx/text
	          {:style (p/TextStyle .fontSize 22.0 .color m/Colors.black)}
	          (if-let [fx (uformx)]
	            (let [root (fmu :teacup2)
	                  samples (mget fx :samples)
	                  lean-tolerance-deg (mget root :lean-tolerance-deg)]
	              (if-let [s (compute-stats samples lean-tolerance-deg)]
	                  (do (dp :summary s)
	                      (str "Lean: min " (.toStringAsFixed ^num (get s :lean-min) 1)
	                           " / avg " (.toStringAsFixed ^num (get s :lean) 1)
	                           " / max " (.toStringAsFixed ^num (get s :lean-max) 1)
	                           " °\n"
		                     (stat-line "Avg bob" (get s :bob) "in/s²") "\n"
	                     (stat-line "Lean std dev" (get s :lean-std-dev) "  °") "\n"
	                     (stat-line "Lean samples" (get s :lean-pct) "%"))  )
	                "No samples yet"))
	            "No data yet"))))))
