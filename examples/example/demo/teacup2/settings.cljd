(ns example.demo.teacup2.settings
  "Settings page for Teacup2."
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:flutter/painting.dart" :as p]
    [tilton.fmx.api :refer [dart-cb] :as fx]
    [tilton.mx.api :refer [mget mset! fmu with-cc]]
    [example.demo.teacup2.sensor :as sensor]))

(defn- source-choice [root selected? source label]
  (fx/gesture-detector
    {:onTap (dart-cb []
              (when (= source :iphone)
                (sensor/disconnect-witmotion!))
              (with-cc :sensor-source-select
                (mset! root :sensor-source source)))}
    (fx/text
      {:style (p/TextStyle
                .fontSize 18.0
                .color (if selected?
                         m/Colors.orange
                         m/Colors.black)
                .fontWeight (if selected?
                              p/FontWeight.bold
                              p/FontWeight.normal))}
      {}
      label)))

(defn- sensor-source-row [root source host-device]
  (fx/padding
    {:padding (m/EdgeInsets.symmetric .horizontal 20.0)}
    (fx/row
      {:mainAxisAlignment  m/MainAxisAlignment.center
       :crossAxisAlignment m/CrossAxisAlignment.center}
      (fx/text
        {:style (p/TextStyle .fontSize 18.0 .color m/Colors.black)}
        {}
        "Sensor:")
      (fx/sized-box {:width 12.0})
      (source-choice root (= source :iphone) :iphone (or host-device "..."))
      (fx/sized-box {:width 36.0})
      (source-choice root (= source :witmotion-ble) :witmotion-ble "WitMotion"))))

(defn- tolerance-choice [root selected? tolerance-deg]
  (fx/sized-box
    {:width 44.0
     :height 40.0}
    (fx/gesture-detector
      {:onTap (dart-cb []
                (with-cc :lean-tolerance-select
                  (mset! root :lean-tolerance-deg tolerance-deg)))}
      (fx/center
        (fx/text
          {:style (p/TextStyle
                    .fontSize 18.0
                    .color (if selected?
                             m/Colors.orange
                             m/Colors.black)
                    .fontWeight (if selected?
                                  p/FontWeight.bold
                                  p/FontWeight.normal))}
          {}
          (str tolerance-deg "°"))))))

(defn- lean-sensitivity-row [root lean-tolerance-deg]
  (let [selected-deg (sensor/normalize-lean-tolerance-deg lean-tolerance-deg)]
    (fx/padding
      {:padding (m/EdgeInsets.symmetric .horizontal 20.0)}
      (fx/row
        {:mainAxisAlignment  m/MainAxisAlignment.center
         :crossAxisAlignment m/CrossAxisAlignment.center}
        (fx/text
          {:style (p/TextStyle .fontSize 18.0 .color m/Colors.black)}
          {}
          "Lean limit")
        (fx/sized-box {:width 12.0})
        (fx/row
          {:mainAxisAlignment m/MainAxisAlignment.center}
          (vec
            (mapcat
              (fn [tolerance-deg]
                (let [choice (tolerance-choice root (= selected-deg tolerance-deg) tolerance-deg)]
                  (if (= tolerance-deg (first sensor/lean-tolerance-options-deg))
                    [choice]
                    [(fx/sized-box {:width 36.0}) choice])))
              sensor/lean-tolerance-options-deg)))))))

(defn settings-page []
  (fx/safe-area
    (let [root   (fmu :teacup2)
          source (mget root :sensor-source)
          host-device (mget root :host-device)
          lean-tolerance-deg (mget root :lean-tolerance-deg)]
      (fx/column
        {:mainAxisAlignment  m/MainAxisAlignment.center
         :crossAxisAlignment m/CrossAxisAlignment.stretch}
        (sensor-source-row root source host-device)
        (m/SizedBox .height 36)
        (lean-sensitivity-row root lean-tolerance-deg)))))
