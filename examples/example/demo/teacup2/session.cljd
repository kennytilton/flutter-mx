(ns example.demo.teacup2.session
  "Session JSON persistence for Teacup2."
  (:require
    ["dart:convert" :as convert]
    ["dart:io" :as io]
    ["package:path_provider/path_provider.dart" :as path]
    [tilton.mx.api :refer [dp mget now-ms]]))

(def player-id "ken")
(def schema-version 1)
(def metrics-version 1)
(def motion-score-version 1)

(defn- mean [xs]
  (if (empty? xs)
    0.0
    (/ (reduce + xs) (count xs))))

(defn- pct [part total]
  (if (zero? total)
    0.0
    (* 100.0 (/ part total))))

(defn- kw-name [x]
  (cond
    (keyword? x) (name x)
    (symbol? x)  (str x)
    :else        (str x)))

(defn- json-ready [x]
  (cond
    (map? x) (into {}
               (map (fn [[k v]]
                      [(kw-name k) (json-ready v)])
                 x))
    (keyword? x) (name x)
    (vector? x)  (mapv json-ready x)
    (seq? x)     (mapv json-ready x)
    :else        x))

(defn- dart-json->cljd [x]
  (cond
    (dart/is? x Map)
    (let [^Map m x]
      (into {}
        (map (fn [k]
               [(keyword k) (dart-json->cljd (. m "[]" k))])
          (.-keys m))))

    (dart/is? x List)
    (let [^List xs x]
      (mapv #(dart-json->cljd (. xs "[]" %))
        (range (.-length xs))))

    (vector? x) (mapv dart-json->cljd x)
    (seq? x)    (mapv dart-json->cljd x)
    :else       x))

(defn- safe-slot [mx slot]
  (try
    (mget mx slot)
    (catch Object _
      nil)))

(defn- pad2 [n]
  (.padLeft (.toString n) 2 "0"))

(defn- file-stamp [ms]
  (let [dt (.toUtc (.fromMillisecondsSinceEpoch DateTime ms))]
    (str (.-year dt)
      "-" (pad2 (.-month dt))
      "-" (pad2 (.-day dt))
      "T" (pad2 (.-hour dt))
      "-" (pad2 (.-minute dt))
      "-" (pad2 (.-second dt))
      "Z")))

(defn- session-stop-ms [formx]
  (or (mget formx :stop-ms)
    (mget formx :pause-start-ms)
    (now-ms)))

(defn- session-metrics [samples start-ms stop-ms paused-total-ms lean-tolerance-deg]
  (let [n (count samples)
        leans (map #(or (get % :lean-deg) 0.0) samples)
        bobs  (map #(or (get % :bob-in-s2)
                     (.abs ^num (or (get % :vertical-accel-in-s2) 0.0))) samples)
        yaw-rates (map #(.abs ^num (or (get % :yaw-rate) 0.0)) samples)
        yaw-accels (map #(.abs ^num (or (get % :yaw-accel) 0.0)) samples)
        lean-over-limit (count (filter #(> % lean-tolerance-deg) leans))
        active-ms (- stop-ms start-ms paused-total-ms)
        lean-over-pct (pct lean-over-limit n)
        bob-avg (mean bobs)
        yaw-accel-avg (mean yaw-accels)
        quality-score (max 0.0
                        (- 100.0
                          (+ lean-over-pct
                            (/ bob-avg 2.0)
                            (/ yaw-accel-avg 8.0))))]
    {:metrics-version metrics-version
     :sample-count n
     :active-duration-ms active-ms
     :quality-score quality-score
     :lean-avg-deg (mean leans)
     :lean-max-deg (if (empty? leans) 0.0 (reduce max leans))
     :lean-over-limit-pct lean-over-pct
     :bob-avg-in-s2 bob-avg
     :yaw-rate-avg-rad-s (mean yaw-rates)
     :yaw-accel-avg-rad-s2 yaw-accel-avg}))

(defn- session-data [root formx comment]
  (let [samples (mget formx :samples)
        start-ms (mget formx :start-ms)
        stop-ms (session-stop-ms formx)
        paused-total-ms (mget formx :paused-total-ms)
        lean-tolerance-deg (mget root :lean-tolerance-deg)
        session-id (file-stamp stop-ms)]
    {:schema-version schema-version
     :app "teacup2"
     :player player-id
     :session-id session-id
     :created-at session-id
     :comment comment
     :timing {:start-ms start-ms
              :stop-ms stop-ms
              :paused-total-ms paused-total-ms}
     :sensor {:source (mget root :sensor-source)
              :remote-id (safe-slot root :selected-ble-remote-id)
              :host-device (safe-slot root :host-device)
              :sample-period-ms 200}
     :umi {:position (safe-slot root :umi-position)
           :mount-code (mget formx :mount-code)
           :neutral-up (mget formx :neutral-up)
           :lean-tolerance-deg lean-tolerance-deg}
     :motion-score-version motion-score-version
     :metrics (session-metrics samples start-ms stop-ms paused-total-ms lean-tolerance-deg)
     :samples samples}))

(defn ^:async save-session! [root formx comment]
  (let [data (session-data root formx comment)
        session-id (get data :session-id)
        ^io/Directory support-dir (await (path/getApplicationSupportDirectory))
        dir-path (str (.-path support-dir)
                   "/teacup2/player/" player-id "/session")
        ^io/Directory session-dir (io/Directory dir-path)
        file-path (str dir-path "/" session-id ".json")
        ^io/File file (io/File file-path)]
    (await (.create session-dir .recursive true))
    (await (.writeAsString file
             (convert/jsonEncode (json-ready data))))
    (dp :session-saved file-path)
    file-path))

(defn ^:async session-dir []
  (let [^io/Directory support-dir (await (path/getApplicationSupportDirectory))
        dir-path (str (.-path support-dir)
                   "/teacup2/player/" player-id "/session")]
    (io/Directory dir-path)))

(defn ^:async delete-session! [path]
  (let [^io/File file (io/File path)]
    (when (await (.exists file))
      (await (.delete file)))
    (dp :session-deleted path)
    path))

(defn ^:async load-session! [path]
  (let [^io/File file (io/File path)
        raw (await (.readAsString file))
        data (dart-json->cljd (convert/jsonDecode raw))]
    (assoc data :path path)))

(defn ^:async list-sessions []
  (let [^io/Directory dir (await (session-dir))]
    (if (await (.exists dir))
      (let [entries (await (.toList (.list dir)))
            files (sort
                    (fn [^io/FileSystemEntity a ^io/FileSystemEntity b]
                      (.compareTo ^String (.-path b) (.-path a)))
                    (filter #(.endsWith ^String
                               (.-path ^io/FileSystemEntity %)
                               ".json")
                      entries))]
        (loop [remaining files
               sessions []]
          (if-let [^io/FileSystemEntity entity (first remaining)]
            (let [^io/File file (io/File (.-path entity))
                  raw (await (.readAsString file))
                  data (dart-json->cljd (convert/jsonDecode raw))]
              (recur (rest remaining)
                (conj sessions
                  (assoc data :path (.-path file)))))
            sessions)))
      [])))
