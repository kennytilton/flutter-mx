(ns example.demo.teacup2.monitor
  "Live monitor page: chart + capture controls."
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
	    [tilton.fmx.api :refer [dart-cb] :as fx]
	    [tilton.mx.api :as mx
	     :refer [dp mget mset! fmu now-ms]]
	    [example.demo.teacup2.util :refer [uformx]]
	    [example.demo.teacup2.util.audio :as audio]
	    [example.demo.teacup2.session :as session]
	    [example.demo.teacup2.plot   :as plot :refer [line-chart chart-data]]))

(def control-icon-size 48.0)
(def chart-tap-slop-squared (* 12.0 12.0))
(def plot-dot-size 24.0)
(def plot-toggle-pad-h 8.0)
(def plot-toggle-pad-v 6.0)

(defn- control-button [tooltip icon color on-pressed]
  (fx/icon-button
    {:tooltip tooltip
     :icon (fx/icon {:color color
                     :size control-icon-size}
             icon)
     :onPressed on-pressed}))

(defn- run! [root]
  (dp :run-pressed)
  (audio/play-sys-sound! audio/SIMToolkit-General-Beep)
  (mset! root :event :start))

(defn- pause! [fx]
  (let [now (now-ms)]
    (dp :pause-pressed :now now)
    (mset! fx :pause-start-ms now)
    (mset! fx :stop-ms now))
  (mset! fx :paused? true)
  (mset! fx :stopped? false)
  (mset! fx :running? false))

(defn- resume! [fx]
  (let [now (now-ms)
        pause-start (mget fx :pause-start-ms)
        pause-ms (if pause-start (- now pause-start) 0)]
    (dp :resume-pressed :pause-ms pause-ms)
    (audio/play-sys-sound! audio/SIMToolkit-General-Beep)
    (mset! fx :paused-total-ms (+ (mget fx :paused-total-ms) pause-ms))
    (mset! fx :record-after-ms (+ (mget fx :record-after-ms) pause-ms))
    (mset! fx :pause-start-ms nil)
    (mset! fx :stop-ms nil))
  (mset! fx :paused? false)
  (mset! fx :stopped? false)
  (mset! fx :running? true))

(defn- stop! [fx]
  (let [now (now-ms)]
    (dp :stop-pressed :now now)
    (mset! fx :stop-ms now))
  (audio/play-sys-sound! audio/SIMToolkit-Negative-ACK)
  (mset! fx :paused? false)
  (mset! fx :stopped? true)
  (mset! fx :running? false))

(defn- show-save-dialog! [root fx ctx]
  (let [^m/TextEditingController comment-controller
        (m/TextEditingController)]
    (m/showDialog
      .context ctx
      .builder (fn [ctx]
                 (fx/fx-render ctx
                   (fx/alert-dialog
                     {:title (m/Text "Save session")}
                     (fx/column
                       {:mainAxisSize m/MainAxisSize.min}
                       (fx/text-field
                         {:controller comment-controller
                          :autofocus true
                          :minLines 2
                          :maxLines 4
                          :decoration (m/InputDecoration
                                        .labelText "Comment")})
                       (fx/row
                         {:mainAxisAlignment m/MainAxisAlignment.end}
	                         (fx/text-button
	                           {:onPressed (dart-cb []
	                                         (-> ctx m/Navigator.of .pop))}
	                           (m/Text "Cancel"))
                         (fx/text-button
                           {:onPressed (dart-cb []
	                                         (let [comment (.-text comment-controller)]
	                                           (dp "SAVING!!!!!")
	                                           (session/save-session! root fx comment)
	                                           (-> ctx m/Navigator.of .pop)))}
	                           (m/Text "Save"))))))))))

(defn- chart-show [root]
  (mget root :display-series))

(defn- toggle-dot [root k ^m/Color color]
  (let [display-series (mget root :display-series)
        on? (get display-series k)]
    (fx/gesture-detector
      {:onTap (dart-cb []
                (let [display-series (mget root :display-series)]
                  (mset! root :display-series
                    (assoc display-series k
                      (not (get display-series k))))))}
      (fx/padding
        {:padding (m/EdgeInsets.symmetric .horizontal plot-toggle-pad-h .vertical plot-toggle-pad-v)}
        (fx/container
          {:width plot-dot-size
           :height plot-dot-size
           :decoration (m/BoxDecoration
                          .color (if on? color (.withOpacity color 0.25))
                          .shape p/BoxShape.circle)})))))

(defn- toggle-symbol [root k label ^m/Color color]
  (let [display-series (mget root :display-series)
        on? (get display-series k)]
    (fx/gesture-detector
      {:onTap (dart-cb []
                (let [display-series (mget root :display-series)]
                  (mset! root :display-series
                    (assoc display-series k
                      (not (get display-series k))))))}
      (fx/padding
        {:padding (m/EdgeInsets.symmetric .horizontal plot-toggle-pad-h .vertical plot-toggle-pad-v)}
        (fx/sized-box
          {:width plot-dot-size
           :height plot-dot-size}
          (fx/center
            (fx/text
              {:style (p/TextStyle
                        .fontSize 20.0
                        .fontWeight p/FontWeight.bold
                        .color (if on? color (.withOpacity color 0.25)))}
              {}
              label)))))))

(defn- plot-toggles [root]
  (when root
    [(fx/sized-box {:width 48.0})
	     (toggle-dot root :bob? m/Colors.red)
	     (toggle-dot root :lean? m/Colors.orange)
	     (toggle-dot root :hz? m/Colors.blue)
	     (toggle-dot root :yaw? m/Colors.purple)
	     (toggle-symbol root :summary? "Σ" m/Colors.black)]))

(defn- save-button [fx]
  (let [enabled? (and fx
                   (seq (mget fx :samples))
                   (or (mget fx :paused?)
                     (mget fx :stopped?)))]
    (control-button "Save" m/Icons.save
      (if enabled? m/Colors.blue m/Colors.grey)
      (when enabled?
        (dart-cb [] (show-save-dialog! (fmu :teacup2) fx ctx))))))

(defn- uuid-first-chunk [remote-id]
  (when remote-id
    (first (.split ^String remote-id "-"))))

(defn- source-label [root]
  (case (mget root :sensor-source)
    :witmotion-ble (str "BLE " (or (uuid-first-chunk (mget root :selected-ble-remote-id)) "..."))
    :iphone        (or (mget root :host-device) "...")
    "..."))

(defn- source-label-view [root]
  (fx/text
    {:textAlign m/TextAlign.center
     :style (p/TextStyle
              .fontSize 14.0
              .color m/Colors.grey)}
    {}
    (source-label root)))

(defn- event-xy [^w/PointerEvent ev]
  (let [^m/Offset p (.-localPosition ev)]
    [(.-dx p) (.-dy p)]))

(defn- chart-pointer-down! [fx ev]
  (let [[x y] (event-xy ev)]
    (dp :chart-pointer-down :full? (mget fx :stopped-full-chart?))
    (mset! fx :chart-pointer-down-x x)
    (mset! fx :chart-pointer-down-y y)
    (mset! fx :chart-pointer-moved? false)))

(defn- chart-pointer-move! [fx ev]
  (when-let [x0 (mget fx :chart-pointer-down-x)]
    (let [[x y] (event-xy ev)
          y0 (mget fx :chart-pointer-down-y)
          dx (- x x0)
          dy (- y y0)]
      (when (> (+ (* dx dx) (* dy dy)) chart-tap-slop-squared)
        (mset! fx :chart-pointer-moved? true)))))

(defn- chart-pointer-up! [fx]
  (let [moved? (mget fx :chart-pointer-moved?)]
    (dp :chart-pointer-up
      :moved? moved?
      :full? (mget fx :stopped-full-chart?))
    (when-not moved?
      (mset! fx :stopped-full-chart?
        (not (mget fx :stopped-full-chart?)))))
  (mset! fx :chart-pointer-down-x nil)
  (mset! fx :chart-pointer-down-y nil)
  (mset! fx :chart-pointer-moved? false))

(defn- chart-pointer-cancel! [fx]
  (dp :chart-pointer-cancel)
  (mset! fx :chart-pointer-down-x nil)
  (mset! fx :chart-pointer-down-y nil)
  (mset! fx :chart-pointer-moved? false))

(defn- controls [root]
  (let [fx (mget root :formx)]
      (fx/row
      {:mainAxisAlignment m/MainAxisAlignment.center}
      (vec (concat
        (cond
	         (or (nil? fx) (mget fx :stopped?))
		         [(control-button "Run" m/Icons.directions_run m/Colors.green
		            (dart-cb [] (run! root)))]

          (mget fx :running?)
	         [(control-button "Pause" m/Icons.pause m/Colors.black
	            (dart-cb [] (pause! fx)))
		          (control-button "Stop" m/Icons.stop_circle m/Colors.red
		            (dart-cb [] (stop! fx)))]

	         (mget fx :paused?)
		         [(control-button "Resume" m/Icons.directions_run m/Colors.green
		            (dart-cb [] (resume! fx)))
		          (control-button "Stop" m/Icons.stop_circle m/Colors.red
		            (dart-cb [] (stop! fx)))]

	         :else
		         [(control-button "Run" m/Icons.directions_run m/Colors.green
		            (dart-cb [] (run! root)))])
        (or (plot-toggles root) [])
        [(fx/sized-box {:width 24.0})
         (save-button fx)])))))

(defn monitor-page []
  (fx/safe-area
    (fx/column
      {:mainAxisAlignment  m/MainAxisAlignment.spaceEvenly
       :crossAxisAlignment m/CrossAxisAlignment.stretch}

      (let [root (fmu :teacup2)]
        (fx/column
          {:crossAxisAlignment m/CrossAxisAlignment.stretch}
          (controls root)
          (source-label-view root)))

      (fx/expanded
        (if-let [fx (uformx)]
	          (let [root (fmu :teacup2)
	                samples  (mget fx :samples)
	                running? (mget fx :running?)
	                stopped? (mget fx :stopped?)
	                stopped-full? (mget fx :stopped-full-chart?)
	                chart (line-chart {}
	                        (chart-data samples running? stopped?
	                          (chart-show root)))]
            (if running?
              chart
              (fx/listener
                {:behavior w/HitTestBehavior.opaque
                 :onPointerDown (dart-cb [ev]
                                  (chart-pointer-down! fx ev))
                 :onPointerMove (dart-cb [ev]
                                  (chart-pointer-move! fx ev))
                 :onPointerUp (dart-cb [_]
                                (chart-pointer-up! fx))
                 :onPointerCancel (dart-cb [_]
                                    (chart-pointer-cancel! fx))}
                (if stopped-full?
                  chart
                  (fx/single-child-scroll-view
                    {:scrollDirection m/Axis.horizontal}
                    (fx/sized-box
                      {:width (plot/stopped-chart-width samples)}
                      chart))))))
          (line-chart {}
            (chart-data [] false)))))))
