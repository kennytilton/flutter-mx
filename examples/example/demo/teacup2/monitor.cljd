(ns example.demo.teacup2.monitor
  "Live monitor page: chart + capture controls."
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
	    [tilton.fmx.api :refer [dart-cb] :as fx]
	    [tilton.mx.api :as mx
	     :refer [dp mget mset! fmu now-ms]]
	    [example.demo.teacup2.util :refer [uformx]]
	    [example.demo.teacup2.util.audio :as audio]
	    [example.demo.teacup2.plot   :as plot :refer [line-chart chart-data]]))

(def control-icon-size 48.0)

(defn- control-button [tooltip icon color on-pressed]
  (fx/icon-button
    {:tooltip tooltip
     :icon (fx/icon {:color color
                     :size control-icon-size}
             icon)
     :onPressed on-pressed}))

(defn- run! [root]
  (dp :run-pressed)
  (audio/play-sys-sound! audio/SIMToolkit-General-Beep)
  (mset! root :event :start))

(defn- pause! [fx]
  (let [now (now-ms)]
    (dp :pause-pressed :now now)
    (mset! fx :pause-start-ms now))
  (mset! fx :paused? true)
  (mset! fx :stopped? false)
  (mset! fx :running? false))

(defn- resume! [fx]
  (let [now (now-ms)
        pause-start (mget fx :pause-start-ms)
        pause-ms (if pause-start (- now pause-start) 0)]
    (dp :resume-pressed :pause-ms pause-ms)
    (audio/play-sys-sound! audio/SIMToolkit-General-Beep)
    (mset! fx :paused-total-ms (+ (mget fx :paused-total-ms) pause-ms))
    (mset! fx :record-after-ms (+ (mget fx :record-after-ms) pause-ms))
    (mset! fx :pause-start-ms nil))
  (mset! fx :paused? false)
  (mset! fx :stopped? false)
  (mset! fx :running? true))

(defn- stop! [fx]
  (dp :stop-pressed)
  (audio/play-sys-sound! audio/SIMToolkit-Negative-ACK)
  (mset! fx :paused? false)
  (mset! fx :stopped? true)
  (mset! fx :running? false))

(defn- controls [root]
  (let [fx (mget root :formx)]
    (fx/row
      {:mainAxisAlignment m/MainAxisAlignment.center}
      (cond
	        (or (nil? fx) (mget fx :stopped?))
		        (control-button "Run" m/Icons.directions_run m/Colors.green
		          (dart-cb [] (run! root)))

        (mget fx :running?)
	        [(control-button "Pause" m/Icons.pause m/Colors.black
	           (dart-cb [] (pause! fx)))
		         (control-button "Stop" m/Icons.stop_circle m/Colors.red
		           (dart-cb [] (stop! fx)))]

	        (mget fx :paused?)
		        [(control-button "Resume" m/Icons.directions_run m/Colors.green
		           (dart-cb [] (resume! fx)))
		         (control-button "Stop" m/Icons.stop_circle m/Colors.red
		           (dart-cb [] (stop! fx)))]

	        :else
		        (control-button "Run" m/Icons.directions_run m/Colors.green
		          (dart-cb [] (run! root)))))))

(defn monitor-page []
  (fx/safe-area
    (fx/column
      {:mainAxisAlignment  m/MainAxisAlignment.spaceEvenly
       :crossAxisAlignment m/CrossAxisAlignment.stretch}

      (controls (fmu :teacup2))

	      (fx/expanded
	        (if-let [fx (uformx)]
	          (let [samples  (mget fx :samples)
	                running? (mget fx :running?)
	                stopped-full? (mget fx :stopped-full-chart?)
	                chart (line-chart {}
	                        (chart-data samples running? stopped-full?))]
	            (if running?
	              chart
			              (fx/gesture-detector
			                {:behavior w/HitTestBehavior.opaque
			                 :onTapDown (dart-cb [_]
			                          (dp :chart-zoom-tap
			                            :full? (mget fx :stopped-full-chart?))
			                          (mset! fx :stopped-full-chart?
			                            (not (mget fx :stopped-full-chart?))))
		                 :onDoubleTap (dart-cb []
		                                (dp :chart-zoom-double-tap
		                                  :full? (mget fx :stopped-full-chart?)))
		                 :onHorizontalDragStart (dart-cb [_]
		                                          (dp :chart-zoom-horizontal-drag-start
		                                            :full? (mget fx :stopped-full-chart?)))}
		                (if stopped-full?
		                  chart
		                  (fx/single-child-scroll-view
		                    {:scrollDirection m/Axis.horizontal}
		                    (fx/sized-box
		                      {:width (plot/stopped-chart-width samples)}
		                      chart))))))
	          (line-chart {}
	            (chart-data [] false)))))))
