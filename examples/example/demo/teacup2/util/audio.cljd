(ns example.demo.teacup2.util.audio
  "Audio helpers and iOS system sound IDs for Teacup2."
  (:require
    ["package:flutter_beep/flutter_beep.dart" :as beep]))

(def New-Mail          1000)
(def Mail-Sent         1001)
(def Voicemail         1002)
(def Received-Message  1003)
(def Sent-Message      1004)
(def Alarm             1005)
(def Low-Power         1006)
(def SMS-Received-1    1007)
(def SMS-Received-2    1008)

(def Anticipate        1020)
(def Bloom             1021)
(def Calypso           1022)
(def Choo-Choo         1023)
(def Descent           1024)
(def Fanfare           1025)
(def Ladder            1026)
(def Minuet            1027)
(def News-Flash        1028)
(def Noir              1029)
(def Sherwood-Forest   1030)
(def Spell             1031)
(def Suspense          1032)
(def Telegraph         1033)
(def Tiptoes           1034)

(def Beep-Beep         1106)
(def Ringer-Changed    1107)
(def Photo-Shutter     1108)
(def Shake             1109)
(def JBL-Begin         1110)
(def JBL-Confirm       1111)
(def JBL-Cancel        1112)
(def Begin-Recording   1113)
(def End-Recording     1114)
(def JBL-Ambiguous     1115)
(def JBL-No-Match      1116)
(def Begin-Video       1117)
(def End-Video         1118)

(defn play-sys-sound! [sound-id]
  (.playSysSound beep/FlutterBeep sound-id))
