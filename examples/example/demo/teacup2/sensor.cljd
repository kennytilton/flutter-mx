(ns example.demo.teacup2.sensor
  "Sensor bridge for Teacup2.

   The app can capture from either the iPhone IMU via sensors_plus or a
   WitMotion WT901BLE device via flutter_blue_plus. Both paths normalize source
   data into the Teacup2 motion scoring sample shape."
  (:require
    ["dart:async" :as async]
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:flutter_blue_plus/flutter_blue_plus.dart" :as fbp]
    ["package:sensors_plus/sensors_plus.dart" :as sp]
    [tilton.mx.api :as mx
     :refer [dp cF+ mget mset! mupdate! fmu wmx-iso now-ms mx-bound? with-cc]]
    [tilton.fmx.api :as fx]
    [example.demo.teacup2.motion :as motion]
    [example.demo.teacup2.util.audio :as audio]
    [example.demo.teacup2.util :refer [uformx]]))

(def sample-period-ms 200)
(def run-duration-ms 10000)
(def run-duration-s  (quot run-duration-ms 1000))

(def device-name-prefix "WT901BLE")
(def scan-timeout-seconds 10)
(def scan-settle-ms 1500)

(def frame-header-byte-0 0x55)
(def frame-header-byte-1 0x61)
(def register-frame-byte-1 0x71)
(def frame-length 20)
(def read-register-command 0x27)
(def rrate-register 0x03)

(def accel-scale (/ 16.0 32768.0))
(def gyro-scale  (/ 2000.0 32768.0))
(def angle-scale (/ 180.0 32768.0))
(def deg->rad (/ math/pi 180.0))

(def rrate-label
  {0x01 "0.1 Hz"
   0x02 "0.5 Hz"
   0x03 "1 Hz"
   0x04 "2 Hz"
   0x05 "5 Hz"
   0x06 "10 Hz"
   0x07 "20 Hz"
   0x08 "50 Hz"
   0x09 "100 Hz"})

(def ready-steady-ms 3000)
(def begin-steady-ms 3000)
(def stop-steady-ms 3000)
(def lean-tolerance-options-deg [5 10 15 20])
(def default-lean-tolerance-deg 15)
(def lean-hysteresis-deg 3.0)
(def steady-gyro-tolerance-rad-s 0.18)
(def steady-linear-accel-tolerance-g 0.15)
(def moving-gyro-rad-s 0.50)
(def moving-linear-accel-g 0.18)
(def nod-gyro-rad-s 0.45)
(def nod-settle-ms 1500)
(def game-over-gyro-rad-s 1.50)
(def game-over-linear-accel-g 0.80)
(def gate-debug-interval-ms 1000)
(def lean-display-interval-ms 500)

(def ^:private ble-state
  (atom {:status "idle"
         :run-id 0
         :scan-sub nil
         :found-device nil
         :found-device-info nil
         :notify-sub nil
         :alert nil
         :alert-showing? false}))

(def ^:private rx-buf (atom []))

;; TODO Teacup2 BLE resilience:
;; - If the user presses Start while Bluetooth is off, show a clear in-app status
;;   and recover when they enable it.
;; - If Bluetooth turns off, the device disconnects, or the WitMotion battery dies
;;   while sampling, stop/mark capture gracefully without losing collected samples.

(defn source-label [source]
  (case source
    :witmotion-ble "WitMotion BLE"
    :iphone        "iPhone IMU"
    "Unknown"))

(defn normalize-lean-tolerance-deg [tolerance-deg]
  (cond
    (= tolerance-deg 5) 5
    (= tolerance-deg 10) 10
    (= tolerance-deg 15) 15
    (= tolerance-deg 20) 20
    :else default-lean-tolerance-deg))

(defn- root-source [me]
  (mget (fmu :teacup2 me) :sensor-source))

(defn- set-ble-status! [s]
  (dp :ble-status-> s)
  (swap! ble-state assoc :status s))

(defn ble-status []
  (get @ble-state :status))

(defn- device-summary [{:keys [name adv remoteId rssi]}]
  (str "name " (or name "-")
    ", adv " (or adv "-")
    ", remoteId " (or remoteId "-")
    ", rssi " (if rssi rssi "-")))

(defn- capture-running? [formx run-id]
  (and formx
       (= run-id (get @ble-state :run-id))
       (mget formx :running?)))

(defn- expected-up [formx raw]
  (motion/up-for-mount (mget formx :mount-code)))

(defn- lean-deg-for [gravity up]
  (motion/rad->deg
    (math/acos
      (.abs ^num
        (motion/clamp
          (motion/dot (motion/normalize gravity) (motion/normalize up))
          -1.0
          1.0)))))

(defn- linear-accel [raw]
  (or (get raw :linear-accel)
    (motion/v- (get raw :accel-raw) (motion/normalize (get raw :gravity)))))

(defn- raw-steady? [raw]
  (and (<= (motion/norm (get raw :gyro)) steady-gyro-tolerance-rad-s)
    (<= (motion/norm (linear-accel raw)) steady-linear-accel-tolerance-g)))

(defn- raw-vertical? [raw up]
  (<= (lean-deg-for (get raw :gravity) up) default-lean-tolerance-deg))

(defn- raw-moving? [raw]
  (or (> (motion/norm (get raw :gyro)) moving-gyro-rad-s)
    (> (motion/norm (linear-accel raw)) moving-linear-accel-g)))

(defn- gyro-abs [raw]
  (let [gyro (get raw :gyro)]
    {:x (.abs ^num (get gyro :x))
     :y (.abs ^num (get gyro :y))
     :z (.abs ^num (get gyro :z))}))

(defn- clear-forward-nod? [raw]
  (let [gyro  (gyro-abs raw)
        max-g (max (get gyro :x)
                (get gyro :y)
                (get gyro :z))]
    (> max-g nod-gyro-rad-s)))

(defn- wild-moving? [gyro-norm lin-norm]
  (or (> gyro-norm game-over-gyro-rad-s)
    (> lin-norm game-over-linear-accel-g)))

(defn- fmt1 [x]
  (if (number? x)
    (.toStringAsFixed ^num x 1)
    "-"))

(defn- fmt2 [x]
  (if (number? x)
    (.toStringAsFixed ^num x 2)
    "-"))

(defn- fmt-v3 [v]
  (if v
    (str (fmt2 (get v :x)) "," (fmt2 (get v :y)) "," (fmt2 (get v :z)))
    "-"))

(defn- elapsed? [formx since-slot now ok? duration-ms]
  (if ok?
    (let [since (or (mget formx since-slot) now)]
      (when-not (mget formx since-slot)
        (mset! formx since-slot now))
      (>= (- now since) duration-ms))
    (do
      (mset! formx since-slot nil)
      false)))

(defn- recording-stop-elapsed? [formx now calm-up? lean-deg tolerance-deg gyro-norm lin-norm]
  (let [since (mget formx :stop-steady-since-ms)]
    (cond
      calm-up?
      (let [since (or since now)]
        (when-not (mget formx :stop-steady-since-ms)
          (mset! formx :stop-steady-since-ms now)
          (dp :recording-stop-timer-start
            :steady-ms stop-steady-ms
            :lean-deg lean-deg
            :lean-max tolerance-deg
            :gyro gyro-norm
            :gyro-steady-max steady-gyro-tolerance-rad-s
            :lin lin-norm
            :lin-steady-max steady-linear-accel-tolerance-g))
        (>= (- now since) stop-steady-ms))

      since
      (do
        (dp :recording-stop-timer-reset
          :elapsed-ms (- now since)
          :steady-ms stop-steady-ms
          :lean-deg lean-deg
          :lean-max tolerance-deg
          :gyro gyro-norm
          :gyro-steady-max steady-gyro-tolerance-rad-s
          :lin lin-norm
          :lin-steady-max steady-linear-accel-tolerance-g)
        (mset! formx :stop-steady-since-ms nil)
        false)

      :else false)))

(defn- clear-ready-gravity! [formx]
  (mset! formx :ready-gravity-sum nil)
  (mset! formx :ready-gravity-count 0))

(defn- track-ready-gravity! [formx raw steady?]
  (if steady?
    (let [gravity (motion/normalize (get raw :gravity))]
      (mset! formx :ready-gravity-sum
        (if-let [sum (mget formx :ready-gravity-sum)]
          (motion/v+ sum gravity)
          gravity))
      (mset! formx :ready-gravity-count
        (inc (or (mget formx :ready-gravity-count) 0))))
    (clear-ready-gravity! formx)))

(defn- ready-neutral-up [formx raw]
  (let [n (mget formx :ready-gravity-count)]
    (if (pos? n)
      (motion/normalize
        (motion/v3 (/ (get (mget formx :ready-gravity-sum) :x) n)
          (/ (get (mget formx :ready-gravity-sum) :y) n)
          (/ (get (mget formx :ready-gravity-sum) :z) n)))
      (motion/normalize (get raw :gravity)))))

(defn- reset-gate! [formx]
  (mset! formx :gate-state :await-ready)
  (mset! formx :neutral-up nil)
  (mset! formx :ready-since-ms nil)
  (clear-ready-gravity! formx)
  (mset! formx :begin-steady-since-ms nil)
  (mset! formx :nod-acked-ms nil)
  (mset! formx :stop-steady-since-ms nil)
  (mset! formx :last-gate-dp-ms nil)
  (mset! formx :last-lean-display-ms nil)
  (mset! formx :saw-recording-motion? false)
  (mset! formx :lean-warning? false)
  (mset! formx :lean-deg nil))

(defn- maybe-display-lean! [formx now lean-deg]
  (let [last-ms (mget formx :last-lean-display-ms)]
    (when (or (nil? last-ms)
            (>= (- now last-ms) lean-display-interval-ms))
      (mset! formx :last-lean-display-ms now)
      (mset! formx :lean-deg lean-deg))))

(defn- maybe-lean-sound! [formx lean-deg tolerance-deg]
  (let [warning? (mget formx :lean-warning?)
        recovery-deg (- tolerance-deg lean-hysteresis-deg)]
    (cond
      (and (not warning?)
        (> lean-deg tolerance-deg))
      (do
        (mset! formx :lean-warning? true)
        (audio/play-sys-sound! audio/USSD))

      (and warning?
        (< lean-deg recovery-deg))
      (do
        (mset! formx :lean-warning? false)
        (audio/play-sys-sound! audio/SMS-Received-2)))))

(defn- game-over! [formx]
  (audio/play-sys-sound! audio/Descent)
  (reset-gate! formx))

(defn- append-scored-sample! [formx raw]
  (let [prior  (last (mget formx :samples))
        sample (motion/score-sample
                 (assoc raw :up (mget formx :neutral-up))
                 prior)]
    (mupdate! formx :samples conj sample)))

(defn- maybe-dp-gate! [formx raw up state lean-deg tolerance-deg gyro-norm lin-norm vertical? steady? moving?]
  (let [now     (get raw :timestamp)
        last-dp (mget formx :last-gate-dp-ms)]
    (when (or (nil? last-dp)
            (>= (- now last-dp) gate-debug-interval-ms))
      (mset! formx :last-gate-dp-ms now)
      (dp :gate
        :st state
        :ok [vertical? steady? moving?]
        :lean (str (fmt1 lean-deg) "/" (fmt1 tolerance-deg))
        :g (fmt-v3 (motion/normalize (get raw :gravity)))))))

(defn- begin-recording! [formx raw up]
  (let [now (get raw :timestamp)]
    (dp :begin-recording)
    (mset! formx :neutral-up up)
    (mset! formx :samples [])
    (mset! formx :start-ms now)
    (mset! formx :secs-left run-duration-s)
    (mset! formx :stop-steady-since-ms nil)
    (mset! formx :saw-recording-motion? false)
    (mset! formx :gate-state :recording)
    (audio/play-sys-sound! audio/Sent-Message)))

(defn- append-raw-sample! [formx raw]
  (wmx-iso
    (when (mget formx :running?)
      (let [now       (get raw :timestamp)
            state     (mget formx :gate-state)
            up        (or (mget formx :neutral-up)
                        (expected-up formx raw))
            lean-deg  (lean-deg-for (get raw :gravity) up)
            tolerance-deg (mget (fmu :teacup2 formx) :lean-tolerance-deg)]
        (maybe-display-lean! formx now lean-deg)
        (maybe-lean-sound! formx lean-deg tolerance-deg)
        (case state
          :await-ready
          (begin-recording! formx raw up)

          :await-nod
          (begin-recording! formx raw up)

          :await-begin-steady
          (begin-recording! formx raw up)

          :recording
          (append-scored-sample! formx raw)

          (reset-gate! formx))))))

(defn- read-i16-le [bs ^int offset]
  (let [lo (nth bs offset)
        hi (nth bs (inc offset))
        u  (bit-or (bit-and lo 0xff)
             (bit-shift-left (bit-and hi 0xff) 8))]
    (if (>= u 0x8000)
      (- u 0x10000)
      u)))

(defn- read-u16-le [bs ^int offset]
  (bit-or (bit-and (nth bs offset) 0xff)
    (bit-shift-left (bit-and (nth bs (inc offset)) 0xff) 8)))

(defn- decode-0x61-frame [bs]
  (when (and (= (count bs) frame-length)
          (= (bit-and (nth bs 0) 0xff) frame-header-byte-0)
          (= (bit-and (nth bs 1) 0xff) frame-header-byte-1))
    (let [ax (read-i16-le bs 2)
          ay (read-i16-le bs 4)
          az (read-i16-le bs 6)
          wx (read-i16-le bs 8)
          wy (read-i16-le bs 10)
          wz (read-i16-le bs 12)
          rx (read-i16-le bs 14)
          ry (read-i16-le bs 16)
          rz (read-i16-le bs 18)]
      {:ax-g      (* ax accel-scale)
       :ay-g      (* ay accel-scale)
       :az-g      (* az accel-scale)
       :wx-rad-s  (* wx gyro-scale deg->rad)
       :wy-rad-s  (* wy gyro-scale deg->rad)
       :wz-rad-s  (* wz gyro-scale deg->rad)
       :roll-deg  (* rx angle-scale)
       :pitch-deg (* ry angle-scale)
       :yaw-deg   (* rz angle-scale)})))

(defn- decode-register-frame [bs]
  (when (and (= (count bs) frame-length)
          (= (bit-and (nth bs 0) 0xff) frame-header-byte-0)
          (= (bit-and (nth bs 1) 0xff) register-frame-byte-1))
    (let [start-reg (read-u16-le bs 2)]
      (when (and (<= start-reg rrate-register)
              (< rrate-register (+ start-reg 8)))
        (let [offset (+ 4 (* 2 (- rrate-register start-reg)))]
          {:start-reg start-reg
           :rrate-code (read-u16-le bs offset)})))))

(defn- log-rrate! [code]
  (let [rate (or (get rrate-label code) "unknown")]
    (dp :ble-rrate
      :register rrate-register
      :code code
      :rate rate)
    (set-ble-status! (str "RRate " rate))
    rate))

(defn- probe-complete-if-ready! [state ^async/Completer done]
  (let [{:keys [rrate-rate lean-deg]} @state]
    (when (and rrate-rate lean-deg (not (.-isCompleted done)))
      (dp :ble-probe-result
        :rrate rrate-rate
        :lean-deg (fmt1 lean-deg))
      (set-ble-status! (str "RRate " rrate-rate ", lean " (fmt1 lean-deg) " deg"))
      (.complete done true))))

(defn- probe-log-lean! [state decoded]
  (when-not (get @state :lean-deg)
    (let [accel-raw (motion/v3 (get decoded :ax-g)
                      (get decoded :ay-g)
                      (get decoded :az-g))
          gravity   (motion/normalize accel-raw)
          lean-deg  (lean-deg-for gravity (motion/up-for-mount :y-up))]
      (dp :ble-probe-lean
        :lean-deg (fmt1 lean-deg)
        :g (fmt-v3 gravity))
      (swap! state assoc :lean-deg lean-deg))))

(defn- witmotion-sample [formx decoded]
  (let [now   (now-ms)
        t-rel (- now (mget formx :start-ms))
        ax    (get decoded :ax-g)
        ay    (get decoded :ay-g)
        az    (get decoded :az-g)
        wx    (get decoded :wx-rad-s)
        wy    (get decoded :wy-rad-s)
        wz    (get decoded :wz-rad-s)
        accel-raw (motion/v3 ax ay az)
        gravity   (motion/normalize accel-raw)]
    {:timestamp now
     :t t-rel
     :source :witmotion-ble
     :up motion/default-up
     :accel-raw accel-raw
     :gravity gravity
     :euler-gravity (motion/euler-gravity (get decoded :roll-deg) (get decoded :pitch-deg))
     :gyro (motion/v3 wx wy wz)
     :pitch (get decoded :pitch-deg)
     :roll (get decoded :roll-deg)
     :yaw (get decoded :yaw-deg)}))

(defn- consume-frames! [formx run-id]
  (loop [buf @rx-buf]
    (cond
      (< (count buf) frame-length)
      (reset! rx-buf buf)

      (not= (bit-and (nth buf 0) 0xff) frame-header-byte-0)
      (recur (subvec buf 1))

      :else
      (let [frame (subvec buf 0 frame-length)
            rest- (subvec buf frame-length)]
        (when-let [decoded (decode-0x61-frame frame)]
          (when (capture-running? formx run-id)
            (append-raw-sample! formx (witmotion-sample formx decoded))))
        (recur rest-)))))

(defn- handle-witmotion-bytes! [formx run-id bytes]
  (let [v (vec bytes)]
    (swap! rx-buf into v)
    (consume-frames! formx run-id)))

(defn- log-characteristic [^fbp/BluetoothCharacteristic c]
  (let [props (.-properties c)]
    (dp :char
      :uuid (.toString (.-uuid c))
      :read (.-read props)
      :write (.-write props)
      :writeNR (.-writeWithoutResponse props)
      :notify (.-notify props)
      :indicate (.-indicate props))))

(defn- pick-notify-characteristic [services]
  (loop [svcs (seq services) found nil]
    (if (or found (nil? svcs))
      found
      (let [^fbp/BluetoothService s (first svcs)]
        (dp :service :uuid (.toString (.-uuid s)))
        (let [chars (.-characteristics s)
              hit   (loop [cs (seq chars) hit nil]
                      (if (or hit (nil? cs))
                        hit
                        (let [^fbp/BluetoothCharacteristic c (first cs)]
                          (log-characteristic c)
                          (recur (next cs)
                            (if (.-notify (.-properties c)) c hit)))))]
          (recur (next svcs) hit))))))

(defn- pick-write-characteristic [services]
  (loop [svcs (seq services) found nil]
    (if (or found (nil? svcs))
      found
      (let [^fbp/BluetoothService s (first svcs)
            chars (.-characteristics s)
            hit   (loop [cs (seq chars) hit nil]
                    (if (or hit (nil? cs))
                      hit
                      (let [^fbp/BluetoothCharacteristic c (first cs)
                            props (.-properties c)]
                        (recur (next cs)
                          (if (or (.-write props)
                                (.-writeWithoutResponse props))
                            c
                            hit)))))]
        (recur (next svcs) hit)))))

(defn- name-matches? [^String s]
  (and (string? s)
       (not (.-isEmpty s))
       (.startsWith s device-name-prefix)))

(defn ^:async stop-witmotion! []
  (swap! ble-state update :run-id inc)
  (set-ble-status! "idle")
  (reset! rx-buf [])
  (when-let [^async/StreamSubscription sub (get @ble-state :scan-sub)]
    (await (.cancel sub)))
  (when-let [^async/StreamSubscription sub (get @ble-state :notify-sub)]
    (await (.cancel sub)))
  (try
    (await (fbp/FlutterBluePlus.stopScan))
    (catch Object e
      (dp :ble-stop-scan-ignored e)))
  (swap! ble-state assoc
    :scan-sub nil
    :notify-sub nil))

(defn ^:async disconnect-witmotion! []
  (await (stop-witmotion!))
  (when-let [^fbp/BluetoothDevice dev (get @ble-state :found-device)]
    (try
      (await (.disconnect dev))
      (catch Object e
        (dp :ble-disconnect-ignored e))))
  (swap! ble-state assoc
    :found-device nil
    :found-device-info nil)
  (set-ble-status! "disconnected"))

(defn- clear-ble-alert-state! []
  (swap! ble-state assoc
    :alert nil
    :alert-showing? false))

(defn- ble-alert! [formx title message]
  (set-ble-status! message)
  (swap! ble-state assoc
    :alert {:title title :message message}
    :alert-showing? false))

(defn ^:async connect-and-listen! [formx run-id ^fbp/BluetoothDevice dev]
  (when (capture-running? formx run-id)
    (let [info (or (get @ble-state :found-device-info)
                 {:name (.-platformName dev)
                  :remoteId (.toString (.-remoteId dev))})]
      (swap! ble-state assoc :found-device-info info)
      (dp :ble-connect-device info)
      (set-ble-status! (str "connecting: " (device-summary info))))
    (try
      (await (.connect dev .timeout (Duration .seconds 15)))
      (when (capture-running? formx run-id)
        (set-ble-status! (str "connected: " (device-summary (get @ble-state :found-device-info))))
        (let [services (await (.discoverServices dev))]
          (if-let [^fbp/BluetoothCharacteristic notify-c
                   (pick-notify-characteristic services)]
            (do
              (dp :using-notify-char :uuid (.toString (.-uuid notify-c)))
              (await (.setNotifyValue notify-c true))
              (set-ble-status! (str "subscribed: " (device-summary (get @ble-state :found-device-info))))
              (let [sub (.listen (.-onValueReceived notify-c)
                          (fn [bytes]
                            (try
                              (handle-witmotion-bytes! formx run-id bytes)
                              (catch Object e
                                (dp :witmotion-decode-exception e)))))]
                (.cancelWhenDisconnected dev sub)
                (swap! ble-state assoc :notify-sub sub)))
            (ble-alert! formx
              "WT901BLE unavailable"
              "WT901BLE has no notify characteristic."))))
      (catch Object e
        (dp :ble-connect-or-discover-failed e)
        (ble-alert! formx
          "WT901BLE connection failed"
          (str "Could not connect to WT901BLE: " e))))))

(defn ^:async on-scan-result [formx run-id ^fbp/ScanResult r]
  (let [name (.-platformName (.-device r))
        adv  (.-advName (.-advertisementData r))
        remoteId (.toString (.-remoteId (.-device r)))
        rssi (.-rssi r)
        info {:name name
              :adv adv
              :remoteId remoteId
              :rssi rssi}
        target? (or (name-matches? name)
                 (name-matches? adv))]
    (when (and (capture-running? formx run-id)
            (nil? (get @ble-state :found-device))
            target?)
      (dp :scan-target info)
      (clear-ble-alert-state!)
      (swap! ble-state assoc
        :found-device (.-device r)
        :found-device-info info)
      (set-ble-status! (str "found: " (device-summary info)))
      (await (fbp/FlutterBluePlus.stopScan))
      (await (connect-and-listen! formx run-id (.-device r))))))

(defn ^:async wait-for-adapter-on! [run-id]
  (set-ble-status! "waiting for BT adapter")
  (let [^async/Stream stream (fbp/FlutterBluePlus.adapterState)
        on-state (.-first (.where stream
                            (fn [s]
                              (and (= run-id (get @ble-state :run-id))
                                (= s fbp/BluetoothAdapterState.on)))))]
    (await on-state)
    (set-ble-status! "adapter on")))

(defn ^:async start-witmotion! [formx]
  (await (stop-witmotion!))
  (clear-ble-alert-state!)
  (let [run-id (get @ble-state :run-id)]
    (try
      (await (wait-for-adapter-on! run-id))
      (when (capture-running? formx run-id)
        (if-let [^fbp/BluetoothDevice dev (get @ble-state :found-device)]
          (await (connect-and-listen! formx run-id dev))
          (do
            (set-ble-status! "scanning")
            (let [sub (.listen (fbp/FlutterBluePlus.onScanResults)
                        (fn [results]
                          (doseq [r results]
                            (on-scan-result formx run-id r))))]
              (swap! ble-state assoc :scan-sub sub)
              (await (fbp/FlutterBluePlus.startScan
                       .timeout (Duration .seconds scan-timeout-seconds)))
              (await (Future.delayed (Duration .milliseconds scan-settle-ms)
                       (fn [] true)))
              (when (and (capture-running? formx run-id)
                      (nil? (get @ble-state :found-device)))
                (ble-alert! formx
                  "Turn on WT901BLE"
                  "The WitMotion sensor was not found."))))))
      (catch Object e
        (dp :witmotion-flow-exception e)
        (set-ble-status! (str "ERROR: " e))))))

(defn- close-ble-alert! [ctx formx]
  (swap! ble-state assoc
    :alert nil
    :alert-showing? false)
  (-> ctx m/Navigator.of .pop))

(defn- show-ble-alert! [ctx formx]
  (let [alert (get @ble-state :alert)]
    (when (and alert (not (get @ble-state :alert-showing?)))
      (doto (.-instance m/WidgetsBinding)
        (.addPostFrameCallback
          (fn [_]
            (let [alert (get @ble-state :alert)]
              (when (and alert (not (get @ble-state :alert-showing?)))
                (let [title   (or (get alert :title) "WT901BLE unavailable")
                      message (or (get alert :message) "The WitMotion sensor is not available.")]
                  (swap! ble-state assoc :alert-showing? true)
                  (let [_ (m/showDialog
                            .context ctx
                            .barrierDismissible false
                            .builder (fn [ctx]
                                       (m/AlertDialog
                                         .title (m/Text title)
                                         .content (m/Text message)
                                         .actions [(m/TextButton
                                                     .onPressed (fn []
                                                                  (stop-witmotion!)
                                                                  (with-cc :ble-alert-ok
                                                                    (reset-gate! formx))
                                                                  (close-ble-alert! ctx formx))
                                                     .child (m/Text "OK"))])))]
                    nil))))))))))

(defn- command-bytes [& xs]
  (mapv #(bit-and % 0xff) xs))

(def writable-register
  {:rrate rrate-register})

(defn- register-code [register]
  (or (get writable-register register)
    (throw (Exception. (str "Unknown BLE register: " register)))))

(defn- ble-write-register! [^fbp/BluetoothCharacteristic write-c register value]
  (.write write-c
    (command-bytes 0xff 0xaa (register-code register) value 0x00)
    .withoutResponse (.-writeWithoutResponse (.-properties write-c))))

(defn ^:async ble-set-device!
  [^fbp/BluetoothDevice dev register value ^async/Completer done]
  (await (fbp/FlutterBluePlus.stopScan))
  (await (.connect dev .timeout (Duration .seconds 15)))
  (let [services (await (.discoverServices dev))]
    (if-let [^fbp/BluetoothCharacteristic write-c
             (pick-write-characteristic services)]
      (do
        (await (ble-write-register! write-c register value))
        (dp :ble-set! :ok register value)
        (when-not (.-isCompleted done)
          (.complete done true)))
      (do
        (dp :ble-set! :error "no write characteristic")
        (when-not (.-isCompleted done)
          (.complete done false))))))

(defn ^:async ble-set! [register value]
  (dp :ble-set! :starting register value)
  (await (stop-witmotion!))
  (let [run-id (get @ble-state :run-id)
        ^async/Completer done (async/Completer)
        target-claimed? (atom false)]
    (try
      (await (wait-for-adapter-on! run-id))
      (set-ble-status! "set scanning")
      (let [scan-sub (.listen (fbp/FlutterBluePlus.onScanResults)
                       (fn [results]
                         (doseq [r results]
                           (let [^fbp/ScanResult r r
                                 ^fbp/BluetoothDevice dev (.-device r)
                                 name (.-platformName dev)
                                 adv  (.-advName (.-advertisementData r))]
                             (when (and (not (.-isCompleted done))
                                     (or (name-matches? name)
                                       (name-matches? adv))
                                     (not @target-claimed?))
                               (reset! target-claimed? true)
                               (future
                                 (await (ble-set-device! dev register value done))))))))]
        (swap! ble-state assoc :scan-sub scan-sub)
        (await (fbp/FlutterBluePlus.startScan
                 .timeout (Duration .seconds scan-timeout-seconds)))
        (await (Future.any [(.-future done)
                            (Future.delayed (Duration .seconds scan-timeout-seconds)
                              (fn [] false))]))
        (when-not (.-isCompleted done)
          (dp :ble-set! :error "timeout")
          (.complete done false)))
      (catch Object e
        (dp :ble-set! :exception e)))
    (await (disconnect-witmotion!))
    (dp :ble-set! :done register value)))

(defn- probe-consume-frames! [rx state ^async/Completer done]
  (loop [buf @rx]
    (cond
      (< (count buf) frame-length)
      (reset! rx buf)

      (not= (bit-and (nth buf 0) 0xff) frame-header-byte-0)
      (recur (subvec buf 1))

      :else
      (let [frame (subvec buf 0 frame-length)
            rest- (subvec buf frame-length)]
        (when-let [{:keys [rrate-code]} (decode-register-frame frame)]
          (swap! state assoc
            :rrate-code rrate-code
            :rrate-rate (log-rrate! rrate-code)))
        (when-let [decoded (decode-0x61-frame frame)]
          (probe-log-lean! state decoded))
        (probe-complete-if-ready! state done)
        (recur rest-)))))

(defn- probe-handle-bytes! [rx state ^async/Completer done bytes]
  (swap! rx into (vec bytes))
  (probe-consume-frames! rx state done))

(defn ^:async probe-device! [^fbp/BluetoothDevice dev rx state ^async/Completer done]
  (await (fbp/FlutterBluePlus.stopScan))
  (await (.connect dev .timeout (Duration .seconds 15)))
  (let [services (await (.discoverServices dev))]
    (if-let [^fbp/BluetoothCharacteristic notify-c
             (pick-notify-characteristic services)]
      (if-let [^fbp/BluetoothCharacteristic write-c
               (pick-write-characteristic services)]
        (do
          (await (.setNotifyValue notify-c true))
          (let [notify-sub (.listen (.-onValueReceived notify-c)
                             (fn [bytes]
                               (probe-handle-bytes! rx state done bytes)))]
            (.cancelWhenDisconnected dev notify-sub)
            (await (.write write-c
                     (command-bytes 0xff 0xaa read-register-command rrate-register 0x00)
                     .withoutResponse (.-writeWithoutResponse (.-properties write-c))))))
        (do
          (dp :ble-probe :error "no write characteristic")
          (when-not (.-isCompleted done)
            (.complete done false))))
      (do
        (dp :ble-probe :error "no notify characteristic")
        (when-not (.-isCompleted done)
          (.complete done false))))))

(defn ^:async probe []
  (dp :ble-probe :rrate :starting)
  (await (stop-witmotion!))
  (let [run-id (get @ble-state :run-id)
        ^async/Completer done (async/Completer)
        rx     (atom [])
        probe-state (atom {})
        target-claimed? (atom false)]
    (try
      (await (wait-for-adapter-on! run-id))
      (set-ble-status! "probe scanning")
      (let [scan-sub (.listen (fbp/FlutterBluePlus.onScanResults)
                       (fn [results]
                         (doseq [r results]
                           (let [^fbp/ScanResult r r
                                 ^fbp/BluetoothDevice dev (.-device r)
                                 name (.-platformName dev)
                                 adv  (.-advName (.-advertisementData r))]
                             (when (and (not (.-isCompleted done))
                                     (or (name-matches? name)
                                       (name-matches? adv))
                                     (not @target-claimed?))
                               (reset! target-claimed? true)
                               (dp :ble-probe :target :platform-name name :adv-name adv)
                               (future
                                 (await (probe-device! dev rx probe-state done))))))))]
        (swap! ble-state assoc :scan-sub scan-sub)
        (await (fbp/FlutterBluePlus.startScan
                 .timeout (Duration .seconds scan-timeout-seconds)))
        (await (Future.any [(.-future done)
                            (Future.delayed (Duration .seconds scan-timeout-seconds)
                              (fn [] false))]))
        (when-not (.-isCompleted done)
          (dp :ble-probe :error "timeout")
          (.complete done false)))
      (catch Object e
        (dp :ble-probe :exception e)))
    (await (disconnect-witmotion!))
    (dp :ble-probe :done)))

(defn- make-iphone-listener [formx last-stamp-atom accel-atom gyro-atom]
  (fn [^sp/UserAccelerometerEvent ev]
    (let [now  (now-ms)
          prior-stamp @last-stamp-atom]
      (when (>= (- now prior-stamp) sample-period-ms)
        (reset! last-stamp-atom now)
        (let [start  (mget formx :start-ms)
              t-rel  (- now start)
              uax    (.-x ev)
              uay    (.-y ev)
              uaz    (.-z ev)
              a      @accel-atom
              ax     (if a (.-x ^sp/AccelerometerEvent a) uax)
              ay     (if a (.-y ^sp/AccelerometerEvent a) uay)
              az     (if a (.-z ^sp/AccelerometerEvent a) uaz)
              g      @gyro-atom
              gx     (if g (.-x ^sp/GyroscopeEvent g) 0.0)
              gy     (if g (.-y ^sp/GyroscopeEvent g) 0.0)
              gz     (if g (.-z ^sp/GyroscopeEvent g) 0.0)
              accel-raw (motion/v3 ax ay az)
              linear    (motion/v3 uax uay uaz)
              gravity   (motion/v- accel-raw linear)
              raw       {:timestamp now
                         :t t-rel
                         :source :iphone
                         :up motion/default-up
                         :accel-raw accel-raw
                         :gravity gravity
                         :linear-accel linear
                         :gyro (motion/v3 gx gy gz)
                         :pitch nil
                         :roll nil
                         :yaw nil}]
          (append-raw-sample! formx raw))))))

(defn capture []
  (let [accel-atom (atom nil)
        gyro-atom  (atom nil)]
    (fx/text
      {:style (fx/within-ctx [me ctx]
                (when-let [formx (uformx)]
                  (show-ble-alert! ctx formx))
                (.-bodySmall (.-textTheme (m/Theme.of ctx))))}
      {:name :capture

       :iphone-accel
       (cF+ [:watch (fn [_ _ new prior _]
                      (when (and (nil? new) (mx-bound? prior) (some? prior))
                        (dp :iphone-accel-cancelling!)
                        (.cancel ^async/StreamSubscription prior)))]
         (let [formx    (uformx)
               running? (when formx (mget formx :running?))]
           (when (and running? (= :iphone (root-source me)))
             (dp :iphone-accel-subscribing!)
             (.listen (sp/accelerometerEventStream
                        .samplingPeriod
                        (Duration .milliseconds sample-period-ms))
               (fn [^sp/AccelerometerEvent ev]
                 (reset! accel-atom ev))))))

       :iphone-gyro
       (cF+ [:watch (fn [_ _ new prior _]
                      (when (and (nil? new) (mx-bound? prior) (some? prior))
                        (dp :iphone-gyro-cancelling!)
                        (.cancel ^async/StreamSubscription prior)))]
         (let [formx    (uformx)
               running? (when formx (mget formx :running?))]
           (when (and running? (= :iphone (root-source me)))
             (dp :iphone-gyro-subscribing!)
             (.listen (sp/gyroscopeEventStream
                        .samplingPeriod
                        (Duration .milliseconds sample-period-ms))
               (fn [^sp/GyroscopeEvent ev]
                 (reset! gyro-atom ev))))))

       :clock
       (cF+ [:watch (fn [_ _ new prior _]
                      (when (and (nil? new) (mx-bound? prior) (some? prior))
                        (dp :clock-cancelling!)
                        (.cancel ^async/Timer prior)))]
         nil)

       :iphone-sub
       (cF+ [:watch (fn [_ _ new prior _]
                      (when (and (nil? new) (mx-bound? prior) (some? prior))
                        (dp :iphone-sub-cancelling!)
                        (.cancel ^async/StreamSubscription prior)))]
         (let [formx    (uformx)
               running? (when formx (mget formx :running?))]
           (when (and running? (= :iphone (root-source me)))
             (let [last-stamp (atom 0)
                   stream     (sp/userAccelerometerEventStream
                                .samplingPeriod
                                (Duration .milliseconds sample-period-ms))]
               (dp :iphone-sensor-subscribing!)
               (.listen stream
                 (make-iphone-listener formx last-stamp accel-atom gyro-atom))))))

       :witmotion
       (cF+ [:watch (fn [_ _ new prior _]
                      (dp :witmotion-watch-sees :new new :prior prior)
                      (when (and (nil? new) (mx-bound? prior) prior)
                        (stop-witmotion!)))]
         (let [formx    (uformx)
               running? (when formx (mget formx :running?))]
           (dp :witmotion-form
             :formx? (boolean formx)
             :running? running?
             :source (root-source me)
             :gate (when formx (mget formx :gate-state)))
           (when (and running? (= :witmotion-ble (root-source me)))
             (dp :witmotion-starting!)
             (start-witmotion! formx)
             true)))}

      (let [formx  (uformx)
            source (root-source me)]
        (cond
          (not (and formx (mget formx :running?))) ""
          (= source :witmotion-ble) (str "Lean " (fmt1 (mget formx :lean-deg)))
          :else (str "Lean " (fmt1 (mget formx :lean-deg))))))))
