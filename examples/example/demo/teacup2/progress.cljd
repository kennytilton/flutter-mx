(ns example.demo.teacup2.progress
  "Progress page for saved Teacup2 sessions."
  (:require
    ["package:fl_chart/fl_chart.dart" :as flc]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/painting.dart" :as p]
    [tilton.fmx.api :as fx]
    [tilton.mx.api :refer [cF+ cI dp fmu mget mset!]]
    [example.demo.teacup2.plot :as plot]
    [example.demo.teacup2.session :as session]))

(defn- fmt1 [x]
  (if (number? x)
    (.toStringAsFixed ^num x 1)
    "-"))

(defn- session-title [s]
  (or (get s :session-id) "Saved session"))

(defn- session-subtitle [s]
  (let [metrics (get s :metrics)
        score (get metrics :quality-score)
        n (get metrics :sample-count)
        comment (get s :comment)]
    (str "Score " (fmt1 score)
      "  Samples " (or n 0)
      (when (and comment (not (.-isEmpty ^String comment)))
        (str "  " comment)))))

(defn ^:async delete-session-and-refresh! [root progress-page path]
  (await (session/delete-session! path))
  (mset! root :ghost-sessions
    (vec (remove #(= path (get % :path))
           (mget root :ghost-sessions))))
  (mset! progress-page :sessions-refresh
    (inc (mget progress-page :sessions-refresh))))

(defn- ghost-selected? [root path]
  (some #(= path (get % :path))
    (mget root :ghost-sessions)))

(defn toggle-ghost-session! [root s]
  (let [path (get s :path)
        ghosts (mget root :ghost-sessions)]
    (if (some #(= path (get % :path)) ghosts)
      (do
        (dp :progress-ghost-off path)
        (mset! root :ghost-sessions
          (vec (remove #(= path (get % :path)) ghosts))))
      (do
        (dp :progress-ghost-on path)
        (mset! root :ghost-sessions
          (conj ghosts s))))))

(defn- clear-missing-ghosts! [progress-page sessions]
  (let [root (fmu :teacup2 progress-page)
        paths (set (map #(get % :path) sessions))
        ghosts (mget root :ghost-sessions)
        live-ghosts (vec (filter #(contains? paths (get % :path)) ghosts))]
    (when (not= (count ghosts) (count live-ghosts))
      (dp :progress-clear-missing-ghosts
        :before (count ghosts)
        :after (count live-ghosts))
      (mset! root :ghost-sessions live-ghosts))))

(defn- session-actions [root progress-page s]
  (let [path (get s :path)
        ghost? (ghost-selected? root path)]
    (m/Row
      .mainAxisSize m/MainAxisSize.min
      .children [(m/IconButton
                   .tooltip "Ghost"
                   .icon (m/Icon m/Icons.show_chart
                           .color (if ghost? m/Colors.blue m/Colors.grey))
                   .onPressed (fn []
                                (toggle-ghost-session! root s)))
                 (m/IconButton
                   .tooltip "Delete"
                   .icon (m/Icon m/Icons.delete)
                   .onPressed (fn []
                                (delete-session-and-refresh!
                                  root
                                  progress-page
                                  path)))])))

(defn- session-tile [root progress-page s]
  (let [path (get s :path)
        ghost? (ghost-selected? root path)]
    (m/Container
      .key (m/ValueKey. path)
      .color (if ghost?
               (.withOpacity m/Colors.blueGrey 0.18)
               m/Colors.transparent)
      .child (m/Column
               .mainAxisSize m/MainAxisSize.min
               .children [(m/ListTile
                            .title (m/Text (session-title s))
                            .subtitle (m/Text (session-subtitle s))
                            .trailing (session-actions root progress-page s))
                          (m/Padding
                            .padding (m/EdgeInsets.only
                                       .left 16.0
                                       .right 16.0
                                       .bottom 8.0)
                            .child (m/SizedBox
                                     .height 48.0
                                     .child (flc/LineChart
                                             (plot/mini-chart-data s))))]))))

(defn progress-page []
  (fx/safe-area
    (fx/column
      {:crossAxisAlignment m/CrossAxisAlignment.stretch}
      {:name :progress-page
       :sessions-refresh (cI 0)
       :sessions (cF+ [:async? true
                       :watch (fn [_ me sessions _ _]
                                (when sessions
                                  (clear-missing-ghosts! me sessions)))]
                   (mget me :sessions-refresh)
                   (session/list-sessions))}
      (fx/padding
        {:padding (m/EdgeInsets.symmetric .horizontal 20.0 .vertical 16.0)}
        (fx/text
          {:style (p/TextStyle
                    .fontSize 24.0
                    .fontWeight p/FontWeight.bold)}
          {}
          "Progress"))
      (fx/expanded
        (let [root (fmu :teacup2)
              progress-page (fmu :progress-page)
              sessions (mget progress-page :sessions)]
          (cond
            (nil? sessions)
            (fx/center (m/Text "Loading..."))

            (empty? sessions)
            (fx/center (m/Text "No saved sessions yet."))

            :else
            (fx/list-view
              (doall
                (map #(session-tile root progress-page %) sessions)))))))))
