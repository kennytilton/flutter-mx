(ns example.demo.teacup2.motion
  "Motion scoring for Teacup2."
  (:require
    ["dart:math" :as math]))

(def default-up {:x 0.0 :y 0.0 :z 1.0})

(def mount-up
  {:z-up           default-up
   :y-up           {:x 0.0 :y 1.0 :z 0.0}
   :up-back-right  {:x 0.0 :y 0.91 :z -0.41}
   :yzx            {:x 0.0 :y 0.91 :z -0.41}})

(def default-weights
  {:jerk 0.45
   :vertical-accel 0.20
   :angular-accel 0.35})

(def default-thresholds
  {:lean-deg 10.0
   :combined-sudden-change 8.0})

(defn v3 [x y z]
  {:x (double x) :y (double y) :z (double z)})

(defn v+ [a b]
  (v3 (+ (get a :x) (get b :x))
    (+ (get a :y) (get b :y))
    (+ (get a :z) (get b :z))))

(defn v- [a b]
  (v3 (- (get a :x) (get b :x))
    (- (get a :y) (get b :y))
    (- (get a :z) (get b :z))))

(defn dot [a b]
  (+ (* (get a :x) (get b :x))
    (* (get a :y) (get b :y))
    (* (get a :z) (get b :z))))

(defn norm [a]
  (math/sqrt (dot a a)))

(defn normalize [a]
  (let [n (norm a)]
    (if (zero? n)
      default-up
      (v3 (/ (get a :x) n) (/ (get a :y) n) (/ (get a :z) n)))))

(defn up-for-mount [mount-code]
  (or (get mount-up mount-code) default-up))

(defn clamp [x lo hi]
  (max lo (min hi x)))

(defn rad->deg [r]
  (* r (/ 180.0 math/pi)))

(defn deg->rad [d]
  (* d (/ math/pi 180.0)))

(defn euler-gravity
  "Approximate gravity vector from roll/pitch using Teacup's z-up convention."
  [roll-deg pitch-deg]
  (let [roll  (deg->rad (or roll-deg 0.0))
        pitch (deg->rad (or pitch-deg 0.0))]
    (normalize
      (v3 (math/sin roll)
        (math/sin pitch)
        (* (math/cos roll) (math/cos pitch))))))

(defn score-sample
  ([raw prior] (score-sample raw prior default-weights))
  ([raw prior weights]
   (let [timestamp (get raw :timestamp)
         accel-raw (get raw :accel-raw)
         gravity   (normalize (get raw :gravity))
         gyro      (get raw :gyro)
         up        (or (get raw :up) default-up)
         linear    (v- accel-raw gravity)
         dt        (if (and prior timestamp (get prior :timestamp))
                     (max 0.001 (/ (- timestamp (get prior :timestamp)) 1000.0))
                     (/ 200.0 1000.0))
         ;; Accelerometer gravity sign differs by source/platform. Lean is
         ;; deviation from the vertical axis, so +up and -up are both upright.
         lean      (math/acos (.abs ^num (clamp (dot gravity (normalize up)) -1.0 1.0)))
         vertical  (dot linear gravity)
         jerk      (if (and prior (get prior :linear-accel))
                     (/ (norm (v- linear (get prior :linear-accel))) dt)
                     0.0)
         angular   (if (and prior (get prior :gyro))
                     (/ (norm (v- gyro (get prior :gyro))) dt)
                     0.0)
         combined  (+ (* (get weights :jerk) jerk)
                     (* (get weights :vertical-accel) (.abs ^num vertical))
                     (* (get weights :angular-accel) angular))]
     (merge raw
       {:lean lean
        :lean-deg (rad->deg lean)
        :gravity gravity
        :linear-accel linear
        :vertical-accel vertical
        :jerk jerk
        :angular-accel angular
        :combined-sudden-change combined
        ;; Compatibility fields during transition.
        :xy (norm (v3 (get linear :x) (get linear :y) 0.0))
        :az vertical
        :gz (get gyro :y)
        :gxz (norm (v3 (get gyro :x) 0.0 (get gyro :z)))}))))
