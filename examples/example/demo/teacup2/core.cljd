(ns example.demo.teacup2.core
  "Teacup2 app shell: material-app, root model, bottom nav.

   Root state:
     :event   -- (cI nil) -- set to :start or :stop by buttons
     :formx   -- (cF ...) -- derives a plain MX model on :start,
                             nil on :stop, _cache otherwise.
                             All run state lives on formx:
                             :samples :start-ms :secs-left :running?
     :current-page-id -- (cI :chart)"
  (:require
    ["dart:math" :as math]
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["package:flutter/painting.dart" :as p]
    ["package:fl_chart/fl_chart.dart" :as flc :refer [LineChart]]
    [tilton.fmx.api :refer [dart-cb] :as fx]
    [tilton.mx.api :as mx
     :refer [cF cF+ cI mget mset! fmu make now-ms _cache-bound]]
    [example.demo.teacup2.sensor :as sensor]
    [example.demo.teacup2.persist :as stg]
    [example.demo.teacup2.util.audio :as audio]
    [example.demo.teacup2.monitor :refer [monitor-page]]
    [example.demo.teacup2.summary :refer [summary-page]]
    [example.demo.teacup2.settings :refer [settings-page]]
    [example.demo.teacup2.hack :refer [hack-page]]))

(def build-tag (.nextInt (math/Random) 1000))

(defn title-text []
  (str "Tai Chi Teacup v" build-tag))

(defn make-formx []
  (make
    :name      :formx
    :samples   (cI [])
    :start-ms  (cI (now-ms))
    :secs-left (cI sensor/run-duration-s)
    :mount-code (cI :up-back-right)
    :neutral-up (cI nil)
    :gate-state (cI :await-ready)
    :ready-since-ms (cI nil)
    :ready-gravity-sum (cI nil)
    :ready-gravity-count (cI 0)
    :begin-steady-since-ms (cI nil)
    :nod-acked-ms (cI nil)
    :stop-steady-since-ms (cI nil)
    :last-gate-dp-ms (cI nil)
    :saw-recording-motion? (cI false)
    :lean-warning? (cI false)
    :ble-alert (cI nil)
    :ble-alert-showing? (cI false)
    :running?  (cI true)))

(defn- page-index [page-id]
  (case page-id
    :chart 0
    :summary 1
    :settings 2
    :hack 3
    0))

(defn- index-page [i]
  (case i
    0 :chart
    1 :summary
    2 :settings
    3 :hack
    :chart))

(defn make-app []
  #_(sensor/ble-set! :rrate 4)
  #_ (sensor/probe)
  (audio/play-sys-sound! audio/Sent-Message)
  (fx/material-app
    {:title (title-text)
     :theme (m/ThemeData .primarySwatch m/Colors.teal)}
    {:name            :teacup2
     :event           (cI nil :ephemeral? true)
     :db              (cF+ [:async? true
                            :watch (fn [_ _ db _ _]
                                     (stg/DB! db))]
                        (stg/open-settings-box))
     :sensor-source   (cF+ [:input? true
                            :watch (fn [_ me new prior _]
                                     (when (mx/mx-bound? prior)
                                       (when-let [db (mget me :db)]
                                         (stg/sensor-source-write! db new))))]
                        (or (when-let [db (mget me :db)]
                              (stg/sensor-source-read db))
                          :iphone))
     :formx           (cF (case (mget me :event)
                             :start (make-formx)
                             :stop  nil
                             (_cache-bound)))
     :current-page-id (cI :chart)}
    (fx/scaffold
      {:appBar              (fx/app-bar
                              {:title (m/Text (title-text))})
       :bottomNavigationBar (cF
                              (let [root (fmu :teacup2)]
                                (fx/bottom-navigation-bar
                                  {:currentIndex (page-index (mget root :current-page-id))
                                   :type         m/BottomNavigationBarType.fixed
                                   :onTap        (dart-cb [i]
                                                   (mset! root :current-page-id
                                                     (index-page i)))}
                                  (fx/bottom-navigation-bar-item
                                    {:icon  (m/Icon m/Icons.show_chart)
                                     :label "Chart"}
                                    {})
                                  (fx/bottom-navigation-bar-item
                                    {:icon  (m/Icon m/Icons.grid_on)
                                     :label "Summary"}
                                    {})
                                  (fx/bottom-navigation-bar-item
                                    {:icon  (m/Icon m/Icons.settings)
                                     :label "Settings"}
                                    {})
                                  (fx/bottom-navigation-bar-item
                                    {:icon  (m/Icon m/Icons.hardware)
                                     :label "Hack"}
                                    {}))))}
      (case (mget (fmu :teacup2) :current-page-id)
        :chart (monitor-page)
        :summary (summary-page)
        :settings (settings-page)
        :hack (hack-page)
        (monitor-page)))))
